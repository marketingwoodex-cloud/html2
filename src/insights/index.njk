<script>
// Filter insights
document.querySelectorAll('.filter-pill').forEach(btn=>{
  btn.setAttribute('aria-pressed', btn.classList.contains('is-on') ? 'true' : 'false');
  btn.addEventListener('click',()=>{
    document.querySelectorAll('.filter-pill').forEach(b=>{b.classList.remove('is-on'); b.setAttribute('aria-pressed','false')});
    btn.classList.add('is-on'); btn.setAttribute('aria-pressed','true');
    const f=btn.dataset.filter;
    document.querySelectorAll('#insights-grid [data-cat]').forEach(card=>{
      if(f==='all' || card.dataset.cat.includes(f)) card.style.display='';
      else card.style.display='none';
    });
    if(window.trackEvent) trackEvent('insights_filter', {filter:f});
  });
});
document.getElementById('insights-form')?.addEventListener('submit', ()=>{ if(window.trackEvent) trackEvent('insights_hub_submit'); });
</script>
