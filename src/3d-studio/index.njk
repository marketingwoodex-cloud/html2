<script>
// Filter pills — accessible + GA4
document.querySelectorAll('.filter-pill').forEach(btn=>{
  btn.setAttribute('aria-pressed', btn.classList.contains('is-on') ? 'true' : 'false');
  btn.addEventListener('click',()=>{
    document.querySelectorAll('.filter-pill').forEach(b=>{b.classList.remove('is-on'); b.setAttribute('aria-pressed','false')});
    btn.classList.add('is-on'); btn.setAttribute('aria-pressed','true');
    const f=btn.dataset.filter;
    document.querySelectorAll('#portfolio-grid [data-cat]').forEach(card=>{
      const show = f==='all' || card.dataset.cat.includes(f);
      if(card.classList.contains('portfolio-extra') && !card.classList.contains('is-revealed') && f!=='all'){ card.style.display='none'; return; }
      card.style.display= show ? '' : 'none';
    });
    if(window.trackEvent) trackEvent('portfolio_filter', {filter: f});
  });
});
// Load more
document.getElementById('load-more')?.addEventListener('click', function(){
  document.querySelectorAll('.portfolio-extra').forEach(el=>{ el.classList.remove('hidden'); el.classList.add('is-revealed'); el.style.display=''; });
  this.style.display='none';
  if(window.trackEvent) trackEvent('portfolio_load_more');
});
// Lightbox — Linoxa minimal + keyboard Enter
(function(){
  const lb = document.createElement('div');
  lb.id='lbox'; lb.style.cssText='position:fixed;inset:0;z-index:9999;background:rgba(12,22,40,0.92);backdrop-filter:blur(8px);display:none;align-items:center;justify-content:center;padding:24px;cursor:zoom-out';
  lb.innerHTML='<img id="lb-img" style="max-width:92vw;max-height:88vh;border-radius:16px;object-fit:contain;box-shadow:0 20px 60px rgba(0,0,0,0.4)" alt=""/><button aria-label="Close" style="position:absolute;top:20px;right:20px;width:40px;height:40px;border-radius:999px;background:white;color:#0f1e36;display:flex;align-items:center;justify-content:center;font-size:18px">✕</button>';
  document.body.appendChild(lb);
  const imgEl = lb.querySelector('#lb-img');
  function openLB(src, alt){ imgEl.src=src; imgEl.alt=alt; lb.style.display='flex'; document.body.style.overflow='hidden'; if(window.trackEvent) trackEvent('portfolio_lightbox_open', {src: alt}); }
  document.querySelectorAll('#portfolio-grid [data-cat] img').forEach(im=>{
    im.style.cursor='zoom-in';
    im.addEventListener('click',()=> openLB(im.src, im.alt));
    im.parentElement.addEventListener('keydown', e=>{ if(e.key==='Enter' || e.key===' '){ e.preventDefault(); openLB(im.src, im.alt); }});
  });
  lb.addEventListener('click',()=>{ lb.style.display='none'; document.body.style.overflow=''; });
  document.addEventListener('keydown', e=>{ if(e.key==='Escape') { lb.style.display='none'; document.body.style.overflow=''; }});
})();
// Before/after slider
(function(){
  const slider = document.getElementById('ba-slider'); if(!slider) return;
  const before = document.getElementById('ba-before'); const handle = document.getElementById('ba-handle'); const range = document.getElementById('ba-range');
  function update(v){ const pct = Math.max(0, Math.min(100, v)); before.style.clipPath = `inset(0 ${100-pct}% 0 0)`; handle.style.left = pct+'%'; range.value = pct; }
  range?.addEventListener('input', e=> update(e.target.value));
  let dragging=false;
  slider.addEventListener('pointerdown', e=>{ dragging=true; slider.setPointerCapture(e.pointerId); });
  slider.addEventListener('pointerup', ()=> dragging=false);
  slider.addEventListener('pointermove', e=>{
    if(!dragging) return;
    const rect = slider.getBoundingClientRect(); const x = e.clientX - rect.left; const pct = (x/rect.width)*100; update(pct);
  });
  update(50);
})();
// Form UX — file size + success mock + GA4
(function(){
  const form = document.getElementById('studio-form'); const success = document.getElementById('form-success'); const card = document.getElementById('form-card');
  if(!form) return;
  form.addEventListener('submit', function(e){
    const file = this.querySelector('input[type="file"]')?.files[0];
    if(file && file.size > 20*1024*1024){ e.preventDefault(); alert('File exceeds 20MB limit. Please compress or send via link in brief.'); if(window.trackEvent) trackEvent('form_file_too_large'); return; }
    if(window.trackEvent) trackEvent('3d_brief_submit', {client_type: this.querySelector('[name="client-type"]')?.value, service: this.querySelector('[name="service-required"]')?.value});
    // Netlify will handle, but show success for demo if no netlify (local)
    if(window.location.hostname==='localhost' || window.location.hostname.includes('e2b')){
      e.preventDefault();
      form.classList.add('hidden'); success.classList.remove('hidden');
      if(window.trackEvent) trackEvent('3d_brief_submit_success');
    }
  });
})();
// Sticky CTA — show after hero
(function(){
  const cta = document.getElementById('sticky-cta'); const hero = document.querySelector('section.hero-fallback'); if(!cta || !hero) return;
  const obs = new IntersectionObserver(entries=>{
    entries.forEach(entry=>{ if(!entry.isIntersecting) cta.classList.add('is-visible'); else cta.classList.remove('is-visible'); });
  }, {threshold:0});
  obs.observe(hero);
})();
// Accordion aria-expanded sync
document.querySelectorAll('details').forEach(d=>{
  const sum = d.querySelector('summary');
  if(!sum) return;
  d.addEventListener('toggle', ()=>{ sum.setAttribute('aria-expanded', d.open ? 'true' : 'false'); const icon = sum.querySelector('.acc-icon'); if(icon) icon.textContent = d.open ? '−' : '+'; });
});
</script>
