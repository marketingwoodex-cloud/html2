{# Block 19: Inclusions Table — Premium — Balanced Spacing — Animation #}
<!-- impeccable-disable all-caps-body, tiny-text -->
<section class="section-premium bg-[#f8f8f8]" data-anim="fade">
  <div class="container-wx">
    <div class="max-w-[720px] mb-10" data-anim="up">
      <p class="eyebrow" style="color:var(--wx-navy);">{{ eyebrow or 'What is included — What is not — No hidden' }}</p>
      <h2 class="mt-3" style="font-family:'Syne',sans-serif; font-size:clamp(1.6rem,3vw,2.2rem); line-height:1.2;">{{ heading or 'Scope written before money written — BOQ turns still into buildable' }}</h2>
    </div>
    <div class="grid grid-cols-12 gap-6" data-anim="up" data-delay="1">
      <div class="col-span-12 lg:col-span-8">
        <div class="card-premium overflow-hidden bg-white">
          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
              <thead><tr class="border-b border-black/5 bg-[#fcf2e8]"><th class="p-4 text-[12px] uppercase tracking-wide font-semibold text-black/50">Item</th><th class="p-4 text-[12px] uppercase tracking-wide font-semibold text-black/50">Included</th><th class="p-4 text-[12px] uppercase tracking-wide font-semibold text-black/50">Notes</th></tr></thead>
              <tbody>
                {% for row in inclusions or [
                  {"item":"Space Planning","inc":"Yes","note":"Focus vs collaboration ratio, circulation, headcount"},
                  {"item":"Concept & Moodboard","inc":"Yes","note":"Brand, product story, materials, lighting"},
                  {"item":"3D Stills","inc":"Yes — one per key room","note":"In-house not render farm, still is contract"},
                  {"item":"BOQ & Cost Plan","inc":"Optional — after 3D approval","note":"No fake sqft rate, plan holds number"},
                  {"item":"Execution & Site","inc":"If turnkey / fit-out","note":"ISO 9001, mill connected to still"},
                  {"item":"Furniture & Joinery","inc":"If scope includes","note":"Workstations, executive tables, reception, sofas"}
                ] %}
                <tr class="border-b border-black/5 hover:bg-[#fcf2e8]/50 transition"><td class="p-4 text-[14px] font-medium">{{ row.item }}</td><td class="p-4 text-[13px] text-[#525252]">{{ row.inc }}</td><td class="p-4 text-[13px] text-black/50">{{ row.note }}</td></tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
      </div>
      <div class="col-span-12 lg:col-span-4" data-anim="right" data-delay="2">
        <div class="p-6 rounded-[16px] bg-[#0f1e36] text-white">
          <p class="text-[12px] uppercase tracking-wide font-semibold text-white/50">No fake sqft rate</p>
          <p class="mt-3 text-[14px] leading-[1.6] text-white/70">Budget with clarity after you approve the room. BOQ turns still into buildable scope. Size, scope, materials, MEP, furniture, timeline — no fake rate — plan holds number — DRAWN. THEN BUILT.</p>
          <div class="mt-6"><a class="btn btn-light" href="/start-your-project/"><span class="btn-label"><span>Start your project</span></span><span class="btn-icon"><svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5"/></svg></span></a></div>
        </div>
      </div>
    </div>
  </div>
</section>
