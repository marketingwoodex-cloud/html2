{# Block 19: Package Inclusions Table #}
<section class="py-16 bg-cream">
  <div class="container max-w-3xl">
    <p class="eyebrow">{{ eyebrow or 'Design Package Inclusions' }}</p>
    <h3 class="text-2xl font-bold mt-2">{{ heading or 'What you get — not vague, named outputs' }}</h3>
    <div class="mt-6 border rounded-wx overflow-hidden bg-white">
      <div class="bg-navy text-white p-4 text-[11px] tracking-[0.18em] uppercase font-semibold grid grid-cols-2"><span>Inclusion</span><span>Details</span></div>
      {% for row in rows or [] %}
      <div class="grid grid-cols-2 p-4 border-b border-ink/10 text-sm hover:bg-cream-2 transition"><span class="font-semibold">{{ row[0] }}</span><span class="text-muted">{{ row[1] }}</span></div>
      {% endfor %}
    </div>
  </div>
</section>
