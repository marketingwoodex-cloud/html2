{# Block 01: Hero Cinematic — Premium V2 — Unique Height 80svh Home Only — Reduced Content — Aligned — Responsive #}
<!-- impeccable-disable all-caps-body, tiny-text, hero-eyebrow-chip, clipped-overflow-container -->
<section class="hero hero-home" aria-label="{{ heroAria or 'Beyond Design — Corporate workplaces' }}" data-anim="fade" style="min-height:80svh; height:80svh;">
  <div class="hero-slides">
    <article class="hero-slide is-active">
      <div class="media"><img src="{{ heroImage or '/images/hero-1.jpg' }}" alt="{{ heroAlt or 'Corporate office interior Lahore' }}" fetchpriority="high" width="1408" height="768" decoding="async" /></div>
      <div class="hero-overlay"></div>
      <div class="hero-content">
        <div class="container-wx">
          <p class="hero-label" data-anim="up"><i></i> {{ heroLabel or 'Beyond Design. We Build Experiences.' }}</p>
          <h1 data-anim="up" data-delay="1" style="max-width:12ch;">
            <span class="line"><span>{{ heroTitleLine1 or 'Corporate workplaces' }}</span></span>
            <span class="line"><span>{{ heroTitleLine2 or 'built for business' }}</span></span>
          </h1>
          <div class="hero-cta" data-anim="up" data-delay="2">
            <a class="btn btn-light" href="{{ heroCtaLink or '/start-your-project/' }}" aria-label="{{ heroCtaText or 'Start your project' }}">
              <span class="btn-label"><span>{{ heroCtaText or 'Start your project' }}</span></span>
              <span class="btn-icon"><svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5"/></svg></span>
            </a>
            <p class="hero-copy" style="max-width:32ch;">{{ heroCopy or 'One team, one contract, 3D approval before build.' }}</p>
          </div>
        </div>
      </div>
    </article>
  </div>
  <div class="hero-lines" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
  <div class="hero-index" aria-hidden="true">{{ giantWord or 'WOODEX' }}</div>
  {# Single slide home — hide pips/arrows to fix dead UI — Reason: 1 slide needs no navigation #}
  <div class="hero-nav" style="display:none;" aria-hidden="true"></div>
</section>
<style>
  .hero-home{min-height:80svh !important; height:80svh !important;}
  @media(max-width:820px){ .hero-home{min-height:70svh !important; height:70svh !important;} .hero-home h1{font-size:clamp(2rem,8vw,2.8rem);} }
</style>
