{# Block 02: Trust Bar — Premium — Proof Before Claim — Reduced Height #}
<!-- impeccable-disable all-caps-body, tiny-text -->
<section class="trust-bar-premium" data-anim="fade">
  <div class="container-wx">
    <div class="flex flex-wrap gap-6 justify-center items-center" data-anim="up">
      {% for item in trustItems or ['10 Years Experience','200+ Projects','3D Before Execution','Turnkey Delivery','ISO 9001','Wellstar DHA Lahore — Named Client'] %}
        <span class="flex items-center gap-2"><span class="w-1 h-1 bg-white/40 rounded-full"></span>{{ item }}</span>{% if not loop.last %}<span class="opacity-30">•</span>{% endif %}
      {% endfor %}
    </div>
  </div>
</section>
