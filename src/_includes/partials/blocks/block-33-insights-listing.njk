{# Block 33: Insights — Blog Listing #}
<section class="py-20 bg-white">
  <div class="container">
    <p class="eyebrow">{{ eyebrow or 'Insights — Notes from studio' }}</p>
    <h2 class="text-4xl font-bold tracking-tightx mt-3">{{ heading or 'All notes — design, cost, process, rooms' }}</h2>
    <div class="grid md:grid-cols-3 gap-6 mt-8">
      {% for post in posts or [] %}
      <a href="{{ post.link }}" class="group rounded-wx overflow-hidden border hover:border-wood/30 hover:shadow-lg transition block">
        <div class="aspect-[16/9] overflow-hidden"><img src="{{ post.img or '/images/hero-1.jpg' }}" alt="{{ post.title }}" class="w-full h-full object-cover group-hover:scale-105 transition duration-600" loading="lazy" /></div>
        <div class="p-6"><p class="eyebrow">{{ post.category }}</p><h3 class="font-semibold mt-2 group-hover:text-wood transition">{{ post.title }}</h3><p class="text-sm text-muted mt-2">{{ post.desc }}</p><span class="inline-flex mt-4 text-sm font-semibold">Discover more →</span></div>
      </a>
      {% endfor %}
    </div>
  </div>
</section>
