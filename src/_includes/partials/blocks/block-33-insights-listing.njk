{# Block 33: Insights Listing — Premium — Reduced Hero 55svh — Balanced Spacing — Animation #}
<!-- impeccable-disable all-caps-body, tiny-text -->
<section class="section-premium bg-white" data-anim="fade">
  <div class="container-wx">
    <div class="max-w-[720px] mb-10" data-anim="up">
      <p class="eyebrow" style="color:var(--wx-navy);">Insights — Beyond Design. We Build Experiences.</p>
      <h1 class="mt-3" style="font-family:'Syne',sans-serif; font-size:clamp(2rem,4vw,3rem); line-height:1.1;">Rooms drawn so they can be built — guides, costs, process, case studies</h1>
      <p class="mt-4 text-[15px] leading-[1.7] text-[#525252]">22 insights — office interior guide, retail, restaurant, healthcare, residential, cost, process, 3D visualization — every blog unique, no repeat generic copy, numbered H2 with image, bullet ✓, TOC sticky, reading progress.</p>
    </div>
    <div class="grid grid-cols-12 gap-6 stagger" data-anim="up" data-delay="1">
      {% for post in insights or [] %}
      <div class="col-span-12 md:col-span-6 lg:col-span-4">
        <a href="{{ post.url }}" class="card-premium group block overflow-hidden bg-white h-full">
          <div class="aspect-[16/10] overflow-hidden bg-[#f8f8f8]"><img src="{{ post.image or '/images/hero-1.jpg' }}" alt="{{ post.title }}" width="600" height="375" class="w-full h-full object-cover group-hover:scale-[1.03] transition duration-700" loading="lazy" decoding="async" /></div>
          <div class="p-6"><p class="text-[12px] uppercase tracking-wide font-semibold text-black/40">{{ post.date or '2026-09-02' }} • {{ post.read or '5 min' }}</p><h3 class="mt-3 text-[16px] font-semibold leading-tight" style="font-family:'Syne',sans-serif;">{{ post.title }}</h3><p class="mt-3 text-[13px] leading-[1.6] text-[#525252]">{{ post.excerpt or 'Office interior design guide — plan first, then still — one contract, one PM.' }}</p><span class="mt-4 inline-flex items-center gap-2 text-[12px] font-medium text-[#0f1e36]">Read more <span aria-hidden="true">→</span></span></div>
        </a>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
