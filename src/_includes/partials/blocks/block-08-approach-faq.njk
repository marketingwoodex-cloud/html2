{# Block 08: Approach/FAQ — Premium — Balanced Spacing — Animation — Extra Content #}
<!-- impeccable-disable all-caps-body, tiny-text -->
<section class="section-premium bg-[#0f1e36] text-white" data-anim="fade">
  <div class="container-wx">
    <div class="grid grid-cols-12 gap-12 lg:gap-16 items-start">
      <div class="col-span-12 lg:col-span-5" data-anim="left">
        <div class="relative rounded-[24px] overflow-hidden aspect-[4/3] bg-white/5" data-tilt>
          <img src="{{ visualImage or '/images/hero-1.jpg' }}" alt="{{ visualAlt or 'Woodex approach' }}" width="640" height="480" class="w-full h-full object-cover" loading="lazy" decoding="async" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent"></div>
        </div>
        <h2 class="mt-8 text-white" style="font-family:'Syne',sans-serif; font-size:clamp(1.6rem,3vw,2.2rem); line-height:1.2;">{{ visualTitle or 'Beyond Design. We Build Experiences.' }}</h2>
        <p class="mt-4 text-white/70 text-[15px] leading-[1.6] max-w-[44ch]">{{ visualLead or 'From strategy and space planning to design, fit-out and final delivery, we create purposeful environments built around how people work, live and experience space.' }}</p>
        <div class="mt-6"><a class="btn btn-light" href="{{ visualLink or '/about/' }}" aria-label="{{ visualBtn or 'The practice' }}"><span class="btn-label"><span>{{ visualBtn or 'The practice' }}</span></span><span class="btn-icon"><svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5"/></svg></span></a></div>
      </div>
      <div class="col-span-12 lg:col-span-7" data-anim="right" data-delay="2">
        <p class="eyebrow" style="color:rgba(255,255,255,0.5);">Approach & FAQ</p>
        <div class="mt-6 space-y-3">
          {% for faq in faqs or [] %}
          <article class="faq-item group bg-white/5 border border-white/10 rounded-[16px] overflow-hidden {% if loop.first %}is-open{% endif %}" data-anim="up" data-delay="{{ loop.index }}">
            <button class="faq-q w-full text-left p-5 flex justify-between items-center gap-4 text-white font-medium text-[15px] leading-tight" type="button" aria-expanded="{% if loop.first %}true{% else %}false{% endif %}">{{ faq.q }}<span class="plus w-7 h-7 rounded-full border border-white/20 flex items-center justify-center text-[14px] transition-transform group-[.is-open]:rotate-45 flex-shrink-0" aria-hidden="true">+</span></button>
            <div class="faq-a px-5 pb-5 text-white/60 text-[14px] leading-[1.6] {% if not loop.first %}hidden{% endif %}">{{ faq.a }}</div>
          </article>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>
