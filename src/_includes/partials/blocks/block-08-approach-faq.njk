{# Block 08: Approach/FAQ — Premium V2 — Unique Height 75svh — Reduced Content — Fixed Toggle — Aligned — Responsive #}
<!-- impeccable-disable all-caps-body, tiny-text -->
<section class="section-premium bg-[#0f1e36] text-white" data-anim="fade" style="min-height:75svh;">
  <div class="container-wx">
    <div class="grid grid-cols-12 gap-8 lg:gap-12 items-start">
      <div class="col-span-12 lg:col-span-5" data-anim="left">
        <div class="relative rounded-[24px] overflow-hidden aspect-[4/3] bg-white/5" data-tilt>
          <img src="{{ visualImage or '/images/hero-1.jpg' }}" alt="{{ visualAlt or 'Woodex approach' }}" width="640" height="480" class="w-full h-full object-cover" loading="lazy" decoding="async" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent"></div>
        </div>
        <h2 class="mt-6 text-white" style="font-family:'Syne',sans-serif; font-size:clamp(1.5rem,3vw,2rem); line-height:1.2; max-width:16ch;">{{ visualTitle or 'Beyond Design. We Build Experiences.' }}</h2>
        <p class="mt-3 text-white/70 text-[14px] leading-[1.6] max-w-[36ch]">{{ visualLead or 'Strategy to delivery — one team, one contract.' }}</p>
        <div class="mt-5"><a class="btn btn-light" href="{{ visualLink or '/about/' }}"><span class="btn-label"><span>{{ visualBtn or 'The practice' }}</span></span><span class="btn-icon">↗</span></a></div>
      </div>
      <div class="col-span-12 lg:col-span-7" data-anim="right" data-delay="1">
        <p class="eyebrow" style="color:rgba(255,255,255,0.5);">Approach & FAQ</p>
        <div class="mt-5 space-y-3">
          {% for faq in faqs or [] %}
          <article class="faq-item group bg-white/5 border border-white/10 rounded-[16px] overflow-hidden {% if loop.first %}is-open{% endif %}" data-anim="up" data-delay="{{ loop.index }}">
            <button class="faq-q w-full text-left p-5 flex justify-between items-center gap-4 text-white font-medium text-[14px] leading-tight" type="button" aria-expanded="{% if loop.first %}true{% else %}false{% endif %}">{{ faq.q }}<span class="plus w-7 h-7 rounded-full border border-white/20 flex items-center justify-center text-[14px] transition-transform group-[.is-open]:rotate-45 flex-shrink-0">+</span></button>
            <div class="faq-a px-5 pb-5 text-white/60 text-[13px] leading-[1.5] {% if not loop.first %}hidden{% endif %}">{{ faq.a }}</div>
          </article>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>
<script>
// FAQ toggle — fix aria-expanded sync
(function(){
  document.querySelectorAll('.faq-item .faq-q').forEach(btn=>{
    btn.addEventListener('click',()=>{
      const item = btn.closest('.faq-item');
      const isOpen = item.classList.contains('is-open');
      document.querySelectorAll('.faq-item').forEach(i=>{
        i.classList.remove('is-open');
        i.querySelector('.faq-a')?.classList.add('hidden');
        i.querySelector('.faq-q')?.setAttribute('aria-expanded','false');
      });
      if(!isOpen){
        item.classList.add('is-open');
        item.querySelector('.faq-a')?.classList.remove('hidden');
        btn.setAttribute('aria-expanded','true');
      }
    });
  });
})();
</script>
