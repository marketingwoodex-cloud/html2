{# Block 32: Start Your Project — Project Brief Funnel #}
<section class="py-20 bg-white">
  <div class="container max-w-3xl">
    <h2 class="text-4xl font-bold tracking-tightx">{{ heading or 'Project Brief — Netlify Forms + GA4' }}</h2>
    <p class="text-muted mt-3">{{ subheading or 'Tell us what you have and where you are. One team. One process. One result. Brief is the contract — not a moodboard.' }}</p>
    <form name="project-brief" method="POST" data-netlify="true" netlify-honeypot="bot-field" class="mt-8 grid gap-6" onsubmit="if(window.trackEvent) trackEvent('form_submit',{form:'project-brief'});">
      <input type="hidden" name="form-name" value="project-brief" />
      <p class="hidden"><label>Don’t fill if human: <input name="bot-field" /></label></p>
      <div class="grid md:grid-cols-2 gap-4">
        <label class="block"><span class="text-sm font-semibold">What space is today? *</span><select name="space_today" required class="mt-1 w-full border rounded-lg p-3"><option value="">Select</option><option>Empty / Shell</option><option>Existing with problems</option><option>Under construction</option><option>Have drawings only</option></select></label>
        <label class="block"><span class="text-sm font-semibold">What must it become? *</span><select name="space_become" required class="mt-1 w-full border rounded-lg p-3"><option value="">Select</option><option>Corporate Office</option><option>Software House</option><option>Retail / Showroom</option><option>Restaurant / Café</option><option>Pharmacy / Clinic / Healthcare</option><option>Residential</option><option>Other Commercial</option></select></label>
      </div>
      <div class="grid md:grid-cols-2 gap-4">
        <label class="block"><span class="text-sm font-semibold">City & Area *</span><input type="text" name="city" required class="mt-1 w-full border rounded-lg p-3" placeholder="e.g., Lahore DHA Phase 6" /></label>
        <label class="block"><span class="text-sm font-semibold">Budget band</span><select name="budget" class="mt-1 w-full border rounded-lg p-3"><option value="">Select if you have</option><option>< 10 Lakh</option><option>10-25 Lakh</option><option>25-50 Lakh</option><option>50 Lakh - 1 Cr</option><option>1 Cr+</option></select></label>
      </div>
      <label class="block"><span class="text-sm font-semibold">Tell us more</span><textarea name="brief" rows="4" class="mt-1 w-full border rounded-lg p-3" placeholder="Brief is the contract — not a moodboard"></textarea></label>
      <div class="grid md:grid-cols-3 gap-4">
        <label class="block"><span class="text-sm font-semibold">Name *</span><input type="text" name="name" required class="mt-1 w-full border rounded-lg p-3" /></label>
        <label class="block"><span class="text-sm font-semibold">Phone *</span><input type="tel" name="phone" required class="mt-1 w-full border rounded-lg p-3" placeholder="+92 322 ..." /></label>
        <label class="block"><span class="text-sm font-semibold">Email *</span><input type="email" name="email" required class="mt-1 w-full border rounded-lg p-3" /></label>
      </div>
      <button type="submit" class="btn"><span class="btn-label"><span>Send the brief</span><span>Send the brief</span></span><span class="btn-icon"><svg viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5"/></svg><svg viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5"/></svg></span></button>
      <p class="text-xs text-muted">By submitting, you agree to be contacted. NAP: M-71 Zainab Tower, Model Town Link Road, Lahore — +92 322 4000768 — info@woodex.com.pk</p>
    </form>
  </div>
</section>
