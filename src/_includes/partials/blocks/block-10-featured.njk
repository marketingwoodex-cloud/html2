{# Block 10: Featured — Premium V2 — Unique Height 65svh — Reduced Content — Fixed Overflow — Aligned — Responsive #}
<!-- impeccable-disable all-caps-body, tiny-text -->
<section class="section-premium bg-white" data-anim="fade" style="min-height:65svh;">
  <div class="container-wx">
    <div class="grid grid-cols-12 gap-8 lg:gap-12 items-center">
      <div class="col-span-12 lg:col-span-6" data-anim="left">
        <div class="relative rounded-[24px] overflow-hidden">
          <div class="rounded-[24px] overflow-hidden aspect-[16/10] bg-[#f8f8f8]" data-tilt>
            <img class="w-full h-full object-cover" src="{{ bigImage or '/images/project-facade.jpg' }}" alt="{{ bigAlt or 'Featured project' }}" width="800" height="500" loading="lazy" decoding="async" />
          </div>
          <div class="absolute -bottom-5 -right-5 w-[38%] rounded-[16px] overflow-hidden border-4 border-white shadow-[0_8px_32px_rgba(0,0,0,0.15)] hidden lg:block" data-anim="up" data-delay="2">
            <img class="w-full h-full object-cover aspect-[4/3]" src="{{ smallImage or '/images/project-urban.jpg' }}" alt="{{ smallAlt or 'Detail' }}" width="320" height="240" loading="lazy" decoding="async" />
          </div>
        </div>
      </div>
      <div class="col-span-12 lg:col-span-6" data-anim="right" data-delay="1">
        <p class="eyebrow" style="color:var(--wx-navy);">From still to site</p>
        <h2 class="mt-3" style="font-family:'Syne',sans-serif; font-size:clamp(1.6rem,3vw,2.2rem); line-height:1.2; max-width:18ch;">{{ heading or 'Approved still to BOQ and site — one team' }}</h2>
        <p class="mt-3 text-[14px] leading-[1.6] text-[#525252] max-w-[40ch]">{{ lead or 'Design first. Budget clarity. Still to scope, then site if brief.' }}</p>
        <ul class="mt-6 space-y-3">
          {% for check in checks or ['Plan, concept, materials — foundation not decoration','3D stills then BOQ — no fake rate','Craft in-house — mill connected to still'] %}
          <li class="flex gap-3 text-[13px] leading-[1.4]"><span class="w-6 h-6 rounded-full bg-[#fcf2e8] text-[#0f1e36] flex items-center justify-center text-[10px] flex-shrink-0 mt-0.5">✓</span><span class="max-w-[36ch]">{{ check }}</span></li>
          {% endfor %}
        </ul>
        <div class="mt-7"><a class="btn" href="{{ ctaLink or '/start-your-project/' }}"><span class="btn-label"><span>{{ ctaText or 'Start your project' }}</span></span><span class="btn-icon">↗</span></a></div>
      </div>
    </div>
  </div>
</section>
