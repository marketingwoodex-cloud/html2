{# Block 10: Featured — Premium — From Approved Still to BOQ and Site — Balanced Spacing — Animation #}
<!-- impeccable-disable all-caps-body, tiny-text -->
<section class="section-premium bg-white" data-anim="fade">
  <div class="container-wx">
    <div class="grid grid-cols-12 gap-12 lg:gap-16 items-center">
      <div class="col-span-12 lg:col-span-6" data-anim="left">
        <div class="relative">
          <div class="rounded-[24px] overflow-hidden aspect-[16/10] bg-[#f8f8f8]" data-tilt>
            <img class="w-full h-full object-cover" src="{{ bigImage or '/images/project-facade.jpg' }}" alt="{{ bigAlt or 'Featured project' }}" width="800" height="500" loading="lazy" decoding="async" />
          </div>
          <div class="absolute -bottom-6 -right-6 w-[40%] rounded-[16px] overflow-hidden border-[4px] border-white shadow-[0_8px_32px_rgba(0,0,0,0.15)] hidden lg:block" data-anim="up" data-delay="2">
            <img class="w-full h-full object-cover aspect-[4/3]" src="{{ smallImage or '/images/project-urban.jpg' }}" alt="{{ smallAlt or 'Detail' }}" width="320" height="240" loading="lazy" decoding="async" />
          </div>
        </div>
      </div>
      <div class="col-span-12 lg:col-span-6" data-anim="right" data-delay="1">
        <p class="eyebrow" style="color:var(--wx-navy);">From still to site</p>
        <h2 class="mt-4" style="font-family:'Syne',sans-serif; font-size:clamp(1.8rem,3vw,2.5rem); line-height:1.2;">{{ heading or 'From approved still to BOQ and site — one accountable team' }}</h2>
        <p class="mt-4 text-[16px] leading-[1.6] text-[#525252] max-w-[48ch]">{{ lead or 'Design first. Budget with clarity. Turn the still into a buildable scope — then site, joinery and handover if that is the brief.' }}</p>
        <ul class="mt-8 space-y-3">
          {% for check in checks or ['Plan, concept, materials — design is foundation not decoration','3D stills — then BOQ — no fake sqft rate','Craft and execution in-house — mill connected to still'] %}
          <li class="flex gap-3 text-[14px] leading-[1.5]"><span class="w-6 h-6 rounded-full bg-[#fcf2e8] text-[#0f1e36] flex items-center justify-center text-[11px] flex-shrink-0 mt-0.5" aria-hidden="true">✓</span><span>{{ check }}</span></li>
          {% endfor %}
        </ul>
        <div class="mt-8"><a class="btn" href="{{ ctaLink or '/start-your-project/' }}" aria-label="{{ ctaText or 'Start your project' }}"><span class="btn-label"><span>{{ ctaText or 'Start your project' }}</span></span><span class="btn-icon"><svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5"/></svg></span></a></div>
      </div>
    </div>
  </div>
</section>
