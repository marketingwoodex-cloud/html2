{# Block 22: Cost Factors — Premium — Balanced Spacing — Animation #}
<!-- impeccable-disable all-caps-body, tiny-text -->
<section class="section-premium bg-white" data-anim="fade">
  <div class="container-wx">
    <div class="grid grid-cols-12 gap-8 lg:gap-12">
      <div class="col-span-12 lg:col-span-5" data-anim="left">
        <p class="eyebrow" style="color:var(--wx-navy);">{{ eyebrow or 'What affects cost?' }}</p>
        <h2 class="mt-3" style="font-family:'Syne',sans-serif; font-size:clamp(1.6rem,3vw,2.2rem); line-height:1.2;">{{ heading or 'Size — Scope — Materials — MEP — Furniture — Branding — Timeline — No fake rate' }}</h2>
        <p class="mt-4 text-[15px] leading-[1.7] text-[#525252]">{{ text or 'We do not publish a fake square-foot rate. Budget with clarity after you approve the room. BOQ turns the still into a buildable scope.' }}</p>
        <div class="mt-8 p-6 rounded-[16px] bg-[#0f1e36] text-white"><p class="text-[13px] font-semibold">No fake sqft rate</p><p class="text-[13px] leading-[1.6] text-white/70 mt-2">Size, scope, materials, MEP, furniture, timeline — no fake rate — plan holds number — DRAWN. THEN BUILT.</p></div>
      </div>
      <div class="col-span-12 lg:col-span-7" data-anim="right" data-delay="1">
        <div class="grid grid-cols-12 gap-4">
          {% for factor in costFactors or ['Workstations — open, focus pods, executive, 25 team, client-facing reception','Acoustic — panels, ceiling, partitions, 24/7 lighting','Lighting — task, ambient, brand, 24/7, travertine, green wall','Flooring — carpet, vinyl, raised, durable, footfall','Glass — partitions, manifestation, acoustic, privacy','Joinery — reception, meeting tables, media walls, custom'] %}
          <div class="col-span-12 md:col-span-6"><div class="card-premium p-5 bg-white flex gap-3"><span class="w-7 h-7 rounded-full bg-[#fcf2e8] text-[#0f1e36] flex items-center justify-center text-[12px] flex-shrink-0" aria-hidden="true">{{ loop.index }}</span><p class="text-[14px] leading-[1.5] text-[#111]">{{ factor }}</p></div></div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>
