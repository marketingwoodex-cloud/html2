{# Block 30: Location Hero — Premium — Reduced Height 60svh — NAP Cards — Different Style #}
<!-- impeccable-disable all-caps-body, tiny-text -->
<section class="location-hero hero-reduced-60" data-anim="fade">
  <div class="container-wx">
    <div class="location-hero-grid">
      <div data-anim="up">
        <nav aria-label="Breadcrumb" style="font-size:12px; color:rgba(255,255,255,0.5); letter-spacing:0.06em; text-transform:uppercase;">{{ breadcrumb or 'Home → Locations → Lahore' }}</nav>
        <h1 class="mt-4" style="font-family:'Syne',sans-serif; font-size:clamp(2rem,4vw,3rem); line-height:1.1; color:#fff; max-width:16ch;">{{ h1 or 'Interior Design Company Lahore — Office, Commercial, Residential' }}</h1>
        <p class="mt-4" style="color:rgba(255,255,255,0.7); font-size:16px; line-height:1.6; max-width:52ch;">{{ subheadline or 'Based in Lahore Since 2016 — Primary office full operations, Islamabad/Karachi project delivery support, Pakistan other cities support. 10 Years | 200+ Projects | 3D Before Execution | Turnkey | ISO 9001' }}</p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a class="btn btn-light" href="{{ cta1Link or '/start-your-project/' }}" aria-label="{{ cta1Text or 'Book a Lahore Consultation' }}"><span class="btn-label"><span>{{ cta1Text or 'Book a Lahore Consultation' }}</span></span><span class="btn-icon"><svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5"/></svg></span></a>
          <a class="btn border" href="{{ cta2Link or '/projects/' }}" aria-label="{{ cta2Text or 'View Lahore Projects' }}"><span class="btn-label"><span>{{ cta2Text or 'View Lahore Projects' }}</span></span></a>
        </div>
      </div>
      <div class="space-y-4" data-anim="up" data-delay="2">
        <div class="bg-white/5 backdrop-blur rounded-[16px] border border-white/10 p-6">
          <p class="text-[11px] tracking-[0.12em] uppercase font-semibold text-white/40">Main Office</p>
          <p class="text-[14px] font-medium mt-3 text-white leading-[1.5]">{{ nap or 'M-71, Zainab Tower, Model Town Link Road, Lahore — +92 322 4000768 — info@woodex.com.pk — Mon-Sat 9:30-18:30' }}</p>
          <div class="mt-4 flex gap-3">
            <a href="tel:+923224000768" class="text-[12px] bg-white text-[#0f1e36] rounded-full px-4 py-2 font-medium hover:bg-[#f8f8f8] transition">Call</a>
            <a href="https://wa.me/923224000768" target="_blank" rel="noopener" class="text-[12px] bg-white/10 text-white rounded-full px-4 py-2 border border-white/10 hover:bg-white/15 transition">WhatsApp</a>
          </div>
        </div>
        <div class="bg-white rounded-[16px] p-6">
          <p class="text-[11px] tracking-[0.12em] uppercase font-semibold text-black/40">Areas we serve</p>
          <p class="text-[13px] mt-3 leading-[1.6] text-[#525252]">{{ areas or 'Gulberg III, DHA Phase 1-8, Model Town, Johar Town, Bahria Town, Cantt, Garden Town, Faisal Town, MM Alam, Link Road' }}</p>
        </div>
      </div>
    </div>
  </div>
</section>
