{# Block 31: Contact — M-71 Zainab Tower — Form + Info — Linoxa Contact Us #}
<section class="py-20 bg-cream">
  <div class="container">
    <div class="grid md:grid-cols-2 gap-12">
      <div>
        <h2 class="text-3xl font-bold tracking-tightx">{{ heading or 'Contact us' }}</h2>
        <p class="text-muted mt-3">{{ subheading or 'Have a project in mind? Get in touch with us to start a conversation and turn your ideas into reality.' }}</p>
        <div class="mt-8 space-y-6">
          <div class="flex gap-4"><div class="w-10 h-10 rounded-full bg-navy text-white flex items-center justify-center">📍</div><div><p class="font-semibold">Main office</p><p class="text-sm text-muted">{{ address or 'M-71, Zainab Tower, Model Town Link Road, Lahore, Pakistan' }}</p></div></div>
          <div class="flex gap-4"><div class="w-10 h-10 rounded-full bg-navy text-white flex items-center justify-center">📞</div><div><p class="font-semibold">Phone no.</p><p class="text-sm text-muted">{{ phones or '+92 322 4000768 / +92 321 4686884' }}</p></div></div>
          <div class="flex gap-4"><div class="w-10 h-10 rounded-full bg-navy text-white flex items-center justify-center">✉️</div><div><p class="font-semibold">Email Id</p><p class="text-sm text-muted">{{ email or 'info@woodex.com.pk' }}</p></div></div>
        </div>
        <p class="text-xs text-muted mt-8 border-l-4 border-wood pl-4">{{ compliance or 'Architectural design and coordination are provided through qualified professionals and specialist consultants where required by law. PCATP/PEC details TBD per Phase 1 gap.' }}</p>
      </div>
      <div class="bg-white rounded-wx p-8 shadow-lg">
        <h3 class="text-2xl font-bold text-center">{{ formTitle or 'Send a message' }}</h3>
        <p class="text-sm text-muted text-center mt-2">{{ formSub or 'We design timeless spaces blending function, beauty, and thoughtful architectural innovation.' }}</p>
        <form name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" class="mt-8 grid gap-6">
          <input type="hidden" name="form-name" value="contact" />
          <p class="hidden"><label>Don’t fill if human: <input name="bot-field" /></label></p>
          <label class="block"><span class="text-sm">Full name*</span><input type="text" name="name" required class="mt-1 w-full border-b border-ink/20 p-3 bg-transparent focus:border-wood outline-none transition" /></label>
          <label class="block"><span class="text-sm">Your email address*</span><input type="email" name="email" required class="mt-1 w-full border-b border-ink/20 p-3 bg-transparent focus:border-wood outline-none transition" /></label>
          <label class="block"><span class="text-sm">Phone number*</span><input type="tel" name="phone" required class="mt-1 w-full border-b border-ink/20 p-3 bg-transparent focus:border-wood outline-none transition" /></label>
          <label class="block"><span class="text-sm">Your message</span><textarea name="message" rows="4" class="mt-1 w-full border-b border-ink/20 p-3 bg-transparent focus:border-wood outline-none transition"></textarea></label>
          <button type="submit" class="btn bg-ink text-white mx-auto"><span class="btn-label"><span>Submit now</span><span>Submit now</span></span><span class="btn-icon"><svg viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5"/></svg><svg viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5"/></svg></span></button>
        </form>
      </div>
    </div>
  </div>
</section>
