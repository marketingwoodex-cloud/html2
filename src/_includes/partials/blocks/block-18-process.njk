{# Block 18: Process — 7 Gates — Polished Horizontal + Vertical Mobile + Line Draw #}
<section class="py-20 bg-cream">
  <div class="container-wx">
    <div class="max-w-3xl">
      <p class="eyebrow">{{ eyebrow or 'The Office Interior Design Process — 7 Gates' }}</p>
      <h3 class="text-3xl md:text-4xl font-bold tracking-tightx mt-3 leading-tight">{{ heading or 'Discover → Design → Visualize → Plan (Budget + BOQ) → Build → Install → Deliver — Stop at gate you choose' }}</h3>
      <p class="mt-3 text-sm text-muted">One team. One process. One result. — Stop at gate you choose — 3D-only is complete for 3D Studio™</p>
    </div>
    <div class="mt-12 relative">
      {# Desktop horizontal line #}
      <div class="hidden md:block absolute top-5 left-0 right-0 h-[2px] bg-black/10"><div class="h-full bg-wood w-0 transition-all duration-700 ease-out" id="process-line"></div></div>
      {# Mobile vertical line #}
      <div class="md:hidden absolute left-5 top-0 bottom-0 w-[2px] bg-black/10"><div class="w-full bg-wood h-0 transition-all duration-700 ease-out" id="process-line-v"></div></div>
      <div class="grid md:grid-cols-7 gap-6 md:gap-4 relative">
        {% for step in steps or [] %}
        <div class="relative flex md:flex-col gap-4 md:gap-0 pl-12 md:pl-0">
          <div class="absolute md:static left-0 top-0 w-10 h-10 rounded-full bg-navy text-white flex items-center justify-center font-bold text-sm flex-shrink-0 ring-4 ring-cream z-10">{{ loop.index }}</div>
          <h4 class="font-semibold mt-1 md:mt-3 text-sm leading-tight {% if 'Visualize' in step.title %}text-wood{% endif %}">{{ step.title }}</h4>
          <p class="hidden md:block text-[12px] text-muted mt-2 leading-relaxed">{{ step.desc }}</p>
          {# Mobile desc collapsible #}
          <p class="md:hidden text-[12px] text-muted mt-1 leading-relaxed absolute left-12 top-10 right-0 md:static">{{ step.desc }}</p>
        </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
<script>
// Process line draw on scroll
(function(){
  const line = document.getElementById('process-line');
  const lineV = document.getElementById('process-line-v');
  const section = line ? line.closest('section') : null;
  if(!section) return;
  const onScroll=()=>{
    const rect = section.getBoundingClientRect();
    const winH = window.innerHeight;
    const progress = Math.min(Math.max((winH - rect.top) / (rect.height + winH*0.5), 0), 1);
    if(line) line.style.width = (progress*100)+'%';
    if(lineV) lineV.style.height = (progress*100)+'%';
  };
  window.addEventListener('scroll', onScroll, {passive:true});
  onScroll();
})();
</script>
