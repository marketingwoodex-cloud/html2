{# Block 26: Final CTA Form — Premium — Balanced Spacing — Animation — Dark + Form #}
<!-- impeccable-disable all-caps-body, tiny-text -->
<section class="section-premium bg-[#0f1e36] text-white relative overflow-hidden" data-anim="fade">
  <div class="absolute inset-0"><img src="{{ ctaBg or '/images/hero-2.jpg' }}" width="1600" height="900" alt="Final CTA" class="w-full h-full object-cover opacity-20" loading="lazy" decoding="async" /><div class="absolute inset-0 bg-gradient-to-r from-[#0f1e36]/90 via-[#0f1e36]/70 to-[#0f1e36]/40"></div></div>
  <div class="absolute inset-0 opacity-[0.06] pointer-events-none" aria-hidden="true"><div class="container-wx h-full flex justify-between"><span class="w-px bg-white h-full"></span><span class="w-px bg-white h-full"></span><span class="w-px bg-white h-full"></span><span class="w-px bg-white h-full"></span></div></div>
  <div class="container-wx relative">
    <div class="grid grid-cols-12 gap-8 lg:gap-12">
      <div class="col-span-12 lg:col-span-6" data-anim="left">
        <h2 class="text-white" style="font-family:'Syne',sans-serif; font-size:clamp(1.8rem,3vw,2.5rem); line-height:1.2;">{{ heading or 'Tell us about your space' }}</h2>
        <p class="mt-4 text-[15px] leading-[1.7] text-white/70 max-w-[48ch]">{{ text or 'Empty hall, floor plan, brand, or drawings. We answer with the next gate — not a brochure. M-71 Zainab Tower, Model Town Link Road, Lahore — 10 years, 200+ projects, ISO 9001, Wellstar DHA Lahore proof.' }}</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="https://wa.me/923224000768" target="_blank" rel="noopener" class="inline-flex items-center gap-2 text-[13px] bg-white/10 border border-white/10 rounded-full px-4 py-2 hover:bg-white/15 transition">WhatsApp <span aria-hidden="true">↗</span></a>
          <a href="tel:+923224000768" class="inline-flex items-center gap-2 text-[13px] bg-white text-[#0f1e36] rounded-full px-4 py-2 font-medium">Call +92 322 4000768</a>
        </div>
        <div class="mt-8 flex flex-wrap gap-2 text-[12px]">
          <span class="px-3 py-1 rounded-full bg-white/10 border border-white/10">M-71 Zainab Tower</span>
          <span class="px-3 py-1 rounded-full bg-white/10 border border-white/10">10 Years Proof</span>
          <span class="px-3 py-1 rounded-full bg-[#fcf2e8] text-[#0f1e36] font-semibold">Wellstar DHA Proof</span>
        </div>
      </div>
      <div class="col-span-12 lg:col-span-6" data-anim="right" data-delay="1">
        <div class="card-premium bg-white p-8 md:p-10 rounded-[24px]">
          <p class="text-[12px] tracking-wide uppercase font-semibold text-black/50">{{ formEyebrow or 'Book a Consultation' }}</p>
          <h3 class="mt-2 text-[20px] font-semibold leading-tight text-[#111]" style="font-family:'Syne',sans-serif;">{{ formHeading or 'Book a Consultation — Tell us about your space' }}</h3>
          <form name="{{ formName or 'final-cta' }}" method="POST" data-netlify="true" class="mt-6 space-y-4" aria-label="Consultation form">
            <input type="hidden" name="form-name" value="{{ formName or 'final-cta' }}" />
            <div class="grid grid-cols-12 gap-4">
              <div class="col-span-12 md:col-span-6"><label for="{{ formName or 'final-cta' }}-full-name" class="text-[12px] tracking-wide uppercase font-semibold text-black/50">Full Name *</label><input id="{{ formName or 'final-cta' }}-full-name" name="full-name" required autocomplete="name" placeholder="CEO / Founder / Head Admin" class="mt-2 w-full border border-black/10 rounded-[10px] px-4 py-3 text-[14px] bg-white focus:outline-none focus:border-[#0f1e36]"  aria-label="CEO / Founder / Head Admin" /></div>
              <div class="col-span-12 md:col-span-6"><label for="{{ formName or 'final-cta' }}-phone" class="text-[12px] tracking-wide uppercase font-semibold text-black/50">Phone *</label><input id="{{ formName or 'final-cta' }}-phone" name="phone" required type="tel" autocomplete="tel" placeholder="+92 322 4000768" class="mt-2 w-full border border-black/10 rounded-[10px] px-4 py-3 text-[14px] bg-white focus:outline-none focus:border-[#0f1e36]"  aria-label="+92 322 4000768" /></div>
              <div class="col-span-12"><label for="{{ formName or 'final-cta' }}-brief" class="text-[12px] tracking-wide uppercase font-semibold text-black/50">Tell us about your space *</label><textarea id="{{ formName or 'final-cta' }}-brief" name="brief" required rows="4" placeholder="What is your space today? What must it become? — Empty hall, floor plan, brand, or drawings — usage, city, budget band" class="mt-2 w-full border border-black/10 rounded-[10px] px-4 py-3 text-[14px] bg-white resize-y focus:outline-none focus:border-[#0f1e36]"></textarea></div>
              <div class="col-span-12 pt-2"><button type="submit" class="btn w-full justify-center"><span class="btn-label"><span>{{ formBtn or 'Book a Consultation' }}</span></span><span class="btn-icon"><svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5"/></svg></span></button><p class="text-[11px] text-black/40 mt-3 text-center leading-[1.5]">By sending, you agree to be contacted about your project — M-71 Zainab Tower, Model Town Link Road, Lahore — info@woodex.com.pk — Mon-Sat 9:30-6:30</p></div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>
