{# Block 13: Service Hero — Premium — Reduced Height 70svh — Different Style — Linoxa #}
<!-- impeccable-disable all-caps-body, tiny-text, hero-eyebrow-chip -->
<section class="service-hero hero-reduced-70" data-anim="fade">
  <div class="container-wx relative" style="z-index:2;">
    <div class="max-w-[760px]">
      <nav aria-label="Breadcrumb" class="crumbs" data-anim="up">
        <span style="color:rgba(255,255,255,0.5); font-size:12px; letter-spacing:0.06em; text-transform:uppercase;">{{ breadcrumb or 'Home → Services → Office Fit-Out' }}</span>
      </nav>
      <h1 class="mt-6" data-anim="up" data-delay="1">{{ h1 or 'Office Fit-Out Services Lahore — Corporate Turnkey' }}</h1>
      <p class="lead mt-6" data-anim="up" data-delay="2">{{ subheadline or 'High-performing corporate environments — designed, built and furnished to reflect your brand, support your team and impress your clients.' }}</p>
      <div class="mt-8 flex flex-wrap gap-4" data-anim="up" data-delay="3">
        <a class="btn btn-light" href="{{ cta1Link or '/start-your-project/' }}" aria-label="{{ cta1Text or 'Book a Consultation' }}">
          <span class="btn-label"><span>{{ cta1Text or 'Book a Consultation' }}</span></span>
          <span class="btn-icon"><svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5"/></svg></span>
        </a>
        <a class="btn border" href="{{ cta2Link or '/projects/' }}" aria-label="{{ cta2Text or 'View Projects' }}">
          <span class="btn-label"><span>{{ cta2Text or 'View Projects' }}</span></span>
        </a>
      </div>
      <div class="mt-10 flex flex-wrap gap-6 text-[12px] tracking-[0.12em] uppercase font-semibold" style="color:rgba(255,255,255,0.5);" data-anim="up" data-delay="4">
        {% for t in trust or ['10 Years','200+ Projects','3D Before Execution','Turnkey'] %}<span class="flex items-center gap-2"><span class="w-1 h-1 bg-white/40 rounded-full"></span>{{ t }}</span>{% if not loop.last %}<span class="opacity-30">•</span>{% endif %}{% endfor %}
      </div>
    </div>
  </div>
  <div class="absolute bottom-0 right-0 opacity-[0.04] pointer-events-none hidden lg:block" aria-hidden="true" style="font-family:'Syne',sans-serif; font-size:clamp(6rem,12vw,14rem); font-weight:800; line-height:0.8; color:#fff; transform:translateY(20%);">Services</div>
</section>
