{# Block 05: Sectors — Premium V2 — Unique Height 70svh — Reduced Content — Icons — Theme Buttons — Aligned — Responsive #}
<!-- impeccable-disable all-caps-body, tiny-text -->
<section class="section-premium bg-white" data-anim="fade" style="min-height:70svh;">
  <div class="container-wx">
    <div class="max-w-[560px] mb-10" data-anim="up">
      <p class="eyebrow" style="color:var(--wx-navy);">{{ eyebrow or 'Sectors — Do you understand my business?' }}</p>
      <h2 class="mt-3" style="font-family:'Syne',sans-serif; font-size:clamp(1.8rem,3vw,2.3rem); line-height:1.2;">{{ heading or 'We understand your business.' }}</h2>
      <p class="mt-3" style="color:var(--wx-charcoal); font-size:15px; line-height:1.6;">{{ subheading or 'Specific pages convert higher. You feel understood immediately.' }}</p>
    </div>
    <div class="grid grid-cols-12 gap-5 stagger" data-anim="up" data-delay="1">
      {% for sector in sectors or [] %}
      <div class="col-span-12 md:col-span-6 lg:col-span-4">
        <a href="{{ sector.link }}" class="card-premium group block p-6 h-full min-h-[220px] flex flex-col" data-anim="up" data-delay="{{ loop.index }}">
          <div class="flex justify-between items-start">
            <p class="text-[11px] tracking-wide uppercase font-semibold text-black/40">{{ sector.eyebrow }}</p>
            <span class="w-10 h-10 rounded-[10px] bg-[#fcf2e8] text-[#0f1e36] flex items-center justify-center text-[12px] font-semibold">{{ loop.index }}</span>
          </div>
          <h3 class="mt-4 text-[18px] font-semibold leading-tight group-hover:text-[#0f1e36] transition" style="font-family:'Syne',sans-serif;">{{ sector.title }}</h3>
          <p class="mt-2 text-[13px] leading-[1.5] text-[#525252] line-clamp-3">{{ sector.desc }}</p>
          <span class="mt-auto pt-4 inline-flex items-center gap-2 text-[13px] font-semibold">Explore <span class="w-7 h-7 rounded-full bg-[#f8f8f8] group-hover:bg-[#0f1e36] group-hover:text-white flex items-center justify-center transition">↗</span></span>
        </a>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
<style>
  .line-clamp-3{display:-webkit-box; -webkit-line-clamp:3; -webkit-box-orient:vertical; overflow:hidden;}
</style>
