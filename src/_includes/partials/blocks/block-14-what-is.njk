{# Block 14: What Is — Premium — Balanced Spacing — Animation — Extra Content — Linoxa #}
<!-- impeccable-disable all-caps-body, tiny-text, tight-leading, image-hover-transform, clipped-overflow-container -->
<section class="section-premium bg-white" data-anim="fade">
  <div class="container-wx">
    <div class="grid grid-cols-12 gap-8 lg:gap-12 items-start">
      <div class="col-span-12 lg:col-span-4" data-anim="left">
        <p class="eyebrow" style="color:var(--wx-navy);">{{ eyebrow or 'What is Office Interior Design?' }}</p>
        <h2 class="mt-4" style="font-family:'Syne',sans-serif; font-size:clamp(1.8rem,3vw,2.5rem); line-height:1.2; max-width:18ch;">{{ heading or 'Design is not decoration. Design is the foundation of a successful project.' }}</h2>
        {% if whatIsCtaLink %}
        <div class="mt-8"><a class="btn" href="{{ whatIsCtaLink }}" aria-label="{{ whatIsCtaText or 'Learn more' }}"><span class="btn-label"><span>{{ whatIsCtaText or 'Learn more' }}</span></span><span class="btn-icon"><svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5"/></svg></span></a></div>
        {% endif %}
        <div class="mt-10 hidden lg:block">
          <div class="w-full h-px bg-black/5"></div>
          <p class="mt-4 text-[12px] leading-[1.6] text-black/40 max-w-[32ch]">Plan first. Then still. Room has to work before anyone decorates it. Survey, still, sheets. Then budget and BOQ if you want it built.</p>
        </div>
      </div>
      <div class="col-span-12 md:col-span-6 lg:col-span-4" data-anim="up" data-delay="1">
        {% if whatIsImage %}
        <div class="rounded-[24px] overflow-hidden aspect-[4/5] bg-[#fcf2e8]" data-tilt>
          <img src="{{ whatIsImage }}" alt="{{ whatIsAlt or heading }}" width="640" height="800" class="w-full h-full object-cover" loading="lazy" decoding="async" />
        </div>
        {% else %}
        <div class="rounded-[24px] overflow-hidden aspect-[4/5] bg-[#0f1e36]/5 p-8 flex flex-col justify-between border border-black/5" data-tilt>
          <div class="text-[72px] font-bold leading-none tracking-[-0.05em] text-[#0f1e36]/10" style="font-family:'Syne',sans-serif;">3D</div>
          <div><p class="text-[14px] font-semibold text-[#0f1e36]">DRAWN. THEN BUILT.</p><p class="text-[13px] leading-[1.6] text-black/50 mt-2 max-w-[24ch]">See the room before it exists. In-house, not render farm. One still per key room, still is contract.</p></div>
        </div>
        {% endif %}
      </div>
      <div class="col-span-12 md:col-span-6 lg:col-span-4 space-y-5" data-anim="right" data-delay="2">
        {% for p in paragraphs or ['Plan first. Then the still. The room has to work before anyone decorates it.','Not a moodboard pack. Survey, still, sheets. Then budget and BOQ if you want it built.','Architectural coordination through qualified professionals where required by law.'] %}
        <p class="text-[15px] leading-[1.7] text-[#525252]">{{ p }}</p>
        {% endfor %}
        <div class="mt-6 p-5 rounded-[16px] bg-[#fcf2e8] border border-black/5">
          <p class="text-[12px] font-semibold tracking-wide uppercase" style="color:var(--wx-navy);">Mill connected to still</p>
          <p class="text-[13px] leading-[1.6] text-[#525252] mt-2">Same still can go to BOQ and mill. Kitchens, wardrobes, counters drawn then made. Where hand goes quality must be — handles, hinges not just facade.</p>
        </div>
      </div>
    </div>
  </div>
</section>
