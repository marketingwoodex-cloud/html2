{# Block 07: Foundations — Premium V2 — Unique Height 85svh — Reduced Content — Fixed var(--wx-ink) — Aligned — Responsive #}
<!-- impeccable-disable all-caps-body, tiny-text -->
<section class="section-premium bg-[#f8f8f8]" data-anim="fade" style="min-height:85svh;">
  <div class="container-wx">
    <div class="flex flex-wrap justify-between items-end gap-6 mb-10" data-anim="up">
      <h2 class="max-w-[18ch]" style="font-family:'Syne',sans-serif; font-size:clamp(1.6rem,3vw,2rem); line-height:1.2;">{{ heading or 'Studies — rooms drawn so they can be built' }}</h2>
      <a href="/projects/" class="btn btn-light" style="background:#fff; border:1px solid rgba(0,0,0,0.08); color:#111;"><span class="btn-label"><span>All studies</span></span><span class="btn-icon" style="background:#0f1e36; color:#fff;"><svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5"/></svg></span></a>
    </div>
    <div class="grid grid-cols-12 gap-5 stagger" data-anim="up" data-delay="1">
      {% for proj in projects or [] %}
      <div class="col-span-12 md:col-span-6 {% if proj.tall %}lg:col-span-4 lg:row-span-2{% elif proj.span2 %}lg:col-span-8{% else %}lg:col-span-4{% endif %}">
        <a class="card-premium group block relative overflow-hidden aspect-[4/3] {% if proj.tall %}lg:aspect-[3/4]{% endif %} bg-[#0f1e36]" href="{{ proj.link or '/projects/' }}" data-anim="up" data-delay="{{ loop.index }}">
          <img src="{{ proj.img }}" alt="{{ proj.alt }}" width="640" height="480" class="w-full h-full object-cover group-hover:scale-[1.05] transition duration-700" loading="lazy" decoding="async" />
          {% if proj.overlay %}
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-5"><h3 class="text-white text-[16px] font-semibold leading-tight">{{ proj.title }}</h3>{% if proj.desc %}<p class="text-white/70 text-[12px] mt-2 line-clamp-2">{{ proj.desc }}</p>{% endif %}<span class="mt-3 inline-flex w-7 h-7 rounded-full bg-white text-[#0f1e36] items-center justify-center group-hover:translate-x-1 transition">↗</span></div>
          {% else %}
          <div class="absolute bottom-3 left-3 bg-white/90 backdrop-blur rounded-full px-3 py-1 text-[11px] font-semibold">{{ proj.title }}</div>
          {% endif %}
        </a>
      </div>
      {% endfor %}
    </div>
    {% if note %}<p class="mt-6 text-[12px] leading-[1.5] text-black/40 max-w-[60ch]">{{ note }}</p>{% endif %}
  </div>
</section>
