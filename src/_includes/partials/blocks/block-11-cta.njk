{# Block 11: CTA — Premium — Tell Us About Your Space — Reduced Height — Balanced Spacing — Animation #}
<!-- impeccable-disable all-caps-body, tiny-text -->
<section class="relative min-h-[60svh] flex items-end overflow-hidden bg-[#0f1e36] text-white section-premium" data-anim="fade">
  <div class="absolute inset-0">
    <img src="{{ ctaImage or '/images/hero-2.jpg' }}" alt="{{ ctaAlt or 'Craft and drawing — Woodex project underway' }}" width="1408" height="768" class="w-full h-full object-cover" loading="lazy" decoding="async" />
    <div class="absolute inset-0 bg-gradient-to-r from-[#0f1e36]/90 via-[#0f1e36]/60 to-[#0f1e36]/20"></div>
  </div>
  <div class="container-wx relative" style="z-index:2;">
    <div class="max-w-[560px]" data-anim="up">
      <h2 class="text-white" style="font-family:'Syne',sans-serif; font-size:clamp(2rem,4vw,3rem); line-height:1.1;">{{ heading or 'Tell us about your space' }}</h2>
      <p class="mt-4 text-white/70 text-[16px] leading-[1.6]">{{ text or 'Empty hall, floor plan, brand, or drawings. We answer with the next gate — not a brochure. M-71 Zainab Tower, Model Town Link Road, Lahore.' }}</p>
      <div class="mt-8"><a class="btn btn-light" href="{{ ctaLink or '/start-your-project/' }}" aria-label="{{ ctaText or 'Send the brief' }}"><span class="btn-label"><span>{{ ctaText or 'Send the brief' }}</span></span><span class="btn-icon"><svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5"/></svg></span></a></div>
    </div>
  </div>
</section>
