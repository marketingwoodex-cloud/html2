{# Block 11: CTA — Premium V2 — Unique Height 60svh — Reduced Content — Fixed items-end to center — Aligned — Responsive #}
<!-- impeccable-disable all-caps-body, tiny-text -->
<section class="relative min-h-[60svh] flex items-center overflow-hidden bg-[#0f1e36] text-white section-premium" data-anim="fade" style="min-height:60svh;">
  <div class="absolute inset-0">
    <img src="{{ ctaImage or '/images/hero-2.jpg' }}" alt="{{ ctaAlt or 'Woodex project' }}" width="1408" height="768" class="w-full h-full object-cover opacity-60" loading="lazy" decoding="async" />
    <div class="absolute inset-0 bg-gradient-to-r from-[#0f1e36]/90 via-[#0f1e36]/60 to-[#0f1e36]/20"></div>
  </div>
  <div class="container-wx relative" style="z-index:2;">
    <div class="max-w-[480px]" data-anim="up">
      <h2 class="text-white" style="font-family:'Syne',sans-serif; font-size:clamp(1.8rem,4vw,2.6rem); line-height:1.1; max-width:14ch;">{{ heading or 'Tell us about your space' }}</h2>
      <p class="mt-3 text-white/70 text-[14px] leading-[1.6] max-w-[36ch]">{{ text or 'Empty hall, floor plan, brand, or drawings. Next gate, not brochure.' }}</p>
      <div class="mt-6"><a class="btn btn-light" href="{{ ctaLink or '/start-your-project/' }}"><span class="btn-label"><span>{{ ctaText or 'Send the brief' }}</span></span><span class="btn-icon">↗</span></a></div>
    </div>
  </div>
</section>
