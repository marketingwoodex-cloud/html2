{# Block 29: Sector Challenge — Premium — Balanced Spacing — Animation — Extra Content #}
<!-- impeccable-disable all-caps-body, tiny-text -->
<section class="section-premium bg-white" data-anim="fade">
  <div class="container-wx">
    <div class="grid grid-cols-12 gap-8 lg:gap-12 items-start">
      <div class="col-span-12 lg:col-span-5" data-anim="left">
        <p class="eyebrow" style="color:var(--wx-navy);">{{ eyebrow or 'The Challenge' }}</p>
        <h2 class="mt-3" style="font-family:'Syne',sans-serif; font-size:clamp(1.8rem,3vw,2.5rem); line-height:1.2;">{{ heading or 'Do you understand my business? — Specificity converts higher' }}</h2>
        <p class="mt-4 text-[15px] leading-[1.7] text-[#525252]">{{ text or 'Service pages tell what we do. Sector pages show we understand your business. Specificity converts higher — P1 Office Fit-Out primary revenue engine — 6 cards.' }}</p>
        <div class="mt-8 p-6 rounded-[16px] bg-[#fcf2e8] border border-black/5">
          <p class="text-[12px] uppercase tracking-wide font-semibold" style="color:var(--wx-navy);">One contract. One PM.</p>
          <p class="text-[14px] leading-[1.6] text-[#525252] mt-2">From strategy and space planning to design, fit-out and final delivery, we create purposeful environments built around how people work, live and experience space.</p>
        </div>
      </div>
      <div class="col-span-12 lg:col-span-7" data-anim="right" data-delay="1">
        <div class="grid grid-cols-12 gap-4">
          {% for card in challenges or [
            {"title":"Brand + Team + Clients","desc":"First 10 seconds judgment, new hire decides career at desk, brand representation"},
            {"title":"Focus vs Collaboration","desc":"60/30/10 ratio, circulation, headcount, growth, demo room for clients"},
            {"title":"Talent Retention","desc":"Breakout, gaming, acoustic, 24/7 lighting, workstations, brand — interior doing HR work"},
            {"title":"Enter, Pause, Pay","desc":"Shop that cannot sell is decoration — customer journey, visual merchandising, lighting"},
            {"title":"Tables, Pass, Light","desc":"Two economies bar + linger, kitchen flow, atmosphere you can sit inside — Saturday night room"},
            {"title":"Compliance, Hygiene, Flow","desc":"Wellstar DHA Lahore proof — pharmacy, cosmetics, mini hospital — patient flow, staff efficiency"}
          ] %}
          <div class="col-span-12 md:col-span-6">
            <article class="card-premium p-6 bg-white h-full">
              <div class="w-10 h-10 rounded-[10px] bg-[#fcf2e8] text-[#0f1e36] flex items-center justify-center text-[12px] font-semibold" aria-hidden="true">0{{ loop.index }}</div>
              <h3 class="mt-4 text-[15px] font-semibold leading-tight" style="font-family:'Syne',sans-serif;">{{ card.title }}</h3>
              <p class="mt-2 text-[13px] leading-[1.6] text-[#525252]">{{ card.desc }}</p>
            </article>
          </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>
