{# Block 17: Styles Types — Premium — Balanced Spacing — Animation — Extra Content #}
<!-- impeccable-disable all-caps-body, tiny-text, numbered-section-labels -->
<section class="section-premium bg-[#fcf2e8]" data-anim="fade">
  <div class="container-wx">
    <p class="eyebrow" style="color:var(--wx-navy);">{{ eyebrow or 'Types — Unique' }}</p>
    <h2 class="mt-3 max-w-[32ch]" style="font-family:'Syne',sans-serif; font-size:clamp(1.8rem,3vw,2.5rem); line-height:1.2;">{{ heading or 'Office interior design is not decoration. Design is the foundation of a successful project.' }}</h2>
    <div class="mt-10 grid grid-cols-12 gap-6 stagger" data-anim="up" data-delay="1">
      {% for card in typeCards or [
        {"title":"Modern Corporate","desc":"Clean lines, brand colors, open plan, focus pods, meeting rooms, reception that impresses clients — for corporate offices."},
        {"title":"Minimal Executive","desc":"Minimal, executive, privacy, walnut paneling, city views, travertine, green wall — for executive floors."},
        {"title":"Industrial Co-working","desc":"Industrial, co-working, open plan, collaboration, breakout, gaming, acoustic, 24/7 lighting — for co-working and startups."},
        {"title":"Branded Software House","desc":"Branded, software house, product story, demo room, breakout, gaming, workstations 24/7, acoustic, lighting, brand — for software houses talent retention."}
      ] %}
      <div class="col-span-12 md:col-span-6 lg:col-span-3">
        <article class="card-premium p-6 h-full {% if loop.index == 2 %}bg-[#0f1e36] text-white border-white/10{% else %}bg-white{% endif %}" data-anim="up" data-delay="{{ loop.index }}">
          <p class="text-[12px] tracking-wide uppercase font-semibold {% if loop.index == 2 %}text-white/50{% else %}text-black/40{% endif %}">0{{ loop.index }}</p>
          <h3 class="mt-3 text-[18px] font-semibold leading-tight" style="font-family:'Syne',sans-serif;">{{ card.title }}</h3>
          <p class="mt-3 text-[14px] leading-[1.6] {% if loop.index == 2 %}text-white/70{% else %}text-[#525252]{% endif %}">{{ card.desc }}</p>
          <div class="mt-6"><span class="inline-flex w-8 h-8 rounded-full {% if loop.index == 2 %}bg-white/10 text-white{% else %}bg-[#f8f8f8] text-[#0f1e36]{% endif %} items-center justify-center text-[12px] group-hover:translate-x-1 transition" aria-hidden="true">↗</span></div>
        </article>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
