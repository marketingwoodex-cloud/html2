{# Block 04: Lx-Pin — Premium — Reduced Height — Slide Animation — Balanced Spacing #}
<!-- impeccable-disable all-caps-body, tiny-text, image-hover-transform, clipped-overflow-container, tight-leading -->
<section class="lx-pin relative bg-[#fcf2e8] section-premium" aria-label="{{ ariaLabel or 'In-house 3D Studio' }}" data-anim="fade">
  <div class="lx-pin-track" style="height:200vh; position:relative">
    <div class="lx-pin-stick sticky top-0" style="height:70svh; overflow:hidden; display:flex; align-items:center; background:#fcf2e8">
      <div class="absolute top-0 left-0 right-0 h-[2px] bg-black/5 z-20"><div id="lx-progress" class="h-full bg-[#0f1e36] w-0 transition-[width] duration-150 ease-linear"></div></div>
      <div class="container-wx w-full py-6">
        <div class="flex flex-col lg:flex-row gap-8 lg:gap-12 items-stretch">
          <div class="lg:w-[52%] w-full" data-anim="left">
            <div class="relative rounded-[24px] overflow-hidden bg-[#0f1e36] aspect-[4/3] lg:aspect-[16/11] shadow-[0_20px_60px_rgba(0,0,0,0.15)]" data-tilt>
              {% for img in pinImages %}
              <img class="absolute inset-0 w-full h-full object-cover transition-opacity duration-700 ease-out {% if loop.first %}opacity-100{% else %}opacity-0{% endif %}" data-pin-img="{{ loop.index0 }}" src="{{ img }}" alt="{{ pinAlts[loop.index0] if pinAlts else '3D Studio' }}" width="800" height="500" {% if loop.first %}fetchpriority="high" decoding="async"{% else %}loading="lazy" decoding="async"{% endif %} />
              {% endfor %}
              <div class="absolute bottom-0 left-0 right-0 p-6 lg:p-8 bg-gradient-to-t from-black/70 via-black/20 to-transparent">
                <h2 class="text-white text-[24px] lg:text-[28px] font-semibold leading-[1.1] tracking-[-0.02em] max-w-[20ch]" style="font-family:'Syne',sans-serif;">{{ kicker or 'See it. Understand it. Build it. — 3D Studio™' }}</h2>
              </div>
            </div>
          </div>
          <div class="lg:w-[48%] w-full" data-anim="right" data-delay="1">
            <div class="bg-white rounded-[24px] p-6 lg:p-8 h-full flex flex-col relative min-h-[420px] lg:min-h-[460px] border border-black/5">
              <div class="relative flex-1">
                {% for copy in pinCopies %}
                <article class="lx-copy absolute inset-0 flex flex-col transition-all duration-700 ease-out {% if loop.first %}opacity-100 translate-y-0{% else %}opacity-0 translate-y-8 pointer-events-none{% endif %}" data-copy="{{ loop.index0 }}">
                  <div class="flex gap-5">
                    <div class="text-[56px] lg:text-[64px] font-bold leading-none tracking-[-0.05em] text-[#0f1e36]/10 select-none" style="font-family:'Syne',sans-serif;">{{ copy.num }}</div>
                    <div class="flex-1 pt-1">
                      <h3 class="text-[18px] lg:text-[20px] font-semibold leading-[1.2] tracking-tight text-[#0f1e36]" style="font-family:'Syne',sans-serif;">{{ copy.title }}</h3>
                      <p class="mt-3 text-[14px] leading-[1.6] text-[#525252] max-w-[36ch]">{{ copy.desc }}</p>
                      <div class="mt-6"><a class="btn" href="{{ copy.link }}"><span class="btn-label"><span>{{ copy.btn }}</span></span><span class="btn-icon"><svg viewBox="0 0 16 16" fill="none" aria-hidden="true" class="w-3 h-3"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5"/></svg></span></a></div>
                    </div>
                  </div>
                </article>
                {% endfor %}
              </div>
              <div class="mt-auto pt-6 border-t border-black/5">
                <div class="flex items-center justify-between">
                  <div class="flex gap-3">
                    {% for img in pinImages %}
                    <button class="lx-thumb w-14 h-10 rounded-[10px] overflow-hidden relative flex-shrink-0 transition-all duration-300 {% if loop.first %}ring-2 ring-[#0f1e36] ring-offset-2 ring-offset-white{% else %}opacity-60 hover:opacity-100{% endif %}" type="button" data-thumb="{{ loop.index0 }}" aria-label="Slide {{ loop.index }}"><img src="{{ img }}" alt="" class="w-full h-full object-cover" loading="lazy" decoding="async" /></button>
                    {% endfor %}
                  </div>
                  <div class="text-[12px] tracking-wide uppercase text-black/40 hidden lg:block">Studio • 3D</div>
                </div>
                <div class="mt-5 hidden lg:flex gap-4 items-center opacity-60">
                  <div class="text-[40px] font-bold leading-none text-[#0f1e36]/10" style="font-family:'Syne',sans-serif;">BOQ</div>
                  <div class="text-[13px] leading-tight text-black/50 max-w-[20ch]">Then money, if you want — 3D Studio™ to BOQ — no fake rate</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<script>
// Premium pin — reduced height 200vh track 70svh sticky — one copy at a time — slide animation
(function(){
  const track = document.querySelector('.lx-pin-track');
  const prog = document.getElementById('lx-progress');
  const imgs = document.querySelectorAll('[data-pin-img]');
  const copies = document.querySelectorAll('[data-copy]');
  const thumbs = document.querySelectorAll('[data-thumb]');
  if(!track) return;
  let ticking=false;
  const setActive=(idx)=>{
    imgs.forEach((im,i)=>{ im.style.opacity = i===idx ? '1' : '0'; });
    copies.forEach((c,i)=>{
      if(i===idx){ c.style.opacity='1'; c.style.transform='translateY(0)'; c.style.pointerEvents='auto'; }
      else { c.style.opacity='0'; c.style.transform='translateY(16px)'; c.style.pointerEvents='none'; }
    });
    thumbs.forEach((t,i)=>{
      if(i===idx){ t.classList.add('ring-2','ring-[#0f1e36]','ring-offset-2','ring-offset-white'); t.style.opacity='1'; }
      else { t.classList.remove('ring-2','ring-[#0f1e36]','ring-offset-2','ring-offset-white'); t.style.opacity='0.6'; }
    });
  };
  const onScroll=()=>{
    if(ticking) return;
    ticking=true;
    requestAnimationFrame(()=>{
      const rect = track.getBoundingClientRect();
      const total = track.offsetHeight - window.innerHeight;
      const progress = Math.min(Math.max(-rect.top / total, 0), 1);
      if(prog) prog.style.width = (progress*100)+'%';
      const idx = Math.min(Math.floor(progress * imgs.length), imgs.length-1);
      setActive(idx);
      ticking=false;
    });
  };
  window.addEventListener('scroll', onScroll, {passive:true});
  thumbs.forEach(t=>{ t.addEventListener('click',()=>{ const i=parseInt(t.dataset.thumb||0); const targetTop = track.offsetTop + (i/imgs.length)* (track.offsetHeight - window.innerHeight); window.scrollTo({top:targetTop, behavior:'smooth'}); }); });
  setActive(0);
  onScroll();
})();
</script>
