{# Block 04: Lx-Pin — Polished — Fix Overlapping — Screenshot 2 #}
<section class="lx-pin relative bg-[#f9f5ed]" aria-label="{{ ariaLabel or 'In-house 3D Studio' }}">
  <div class="lx-pin-track" style="height:300vh; position:relative">
    <div class="lx-pin-stick sticky top-0" style="height:100svh; overflow:hidden; display:flex; align-items:center; background:#f9f5ed">
      {# Progress bar top #}
      <div class="absolute top-0 left-0 right-0 h-[2px] bg-black/5 z-20"><div id="lx-progress" class="h-full bg-wood w-0 transition-[width] duration-150 ease-linear"></div></div>
      
      <div class="container-wx w-full py-8">
        <div class="flex flex-col lg:flex-row gap-6 lg:gap-8 items-stretch">
          {# Left media — rounded 24px like screenshot #}
          <div class="lg:w-[52%] w-full">
            <div class="relative rounded-[24px] overflow-hidden bg-navy aspect-[4/3] lg:aspect-[16/11] shadow-[0_20px_60px_rgba(0,0,0,0.15)]">
              {% for img in pinImages %}
              <img class="absolute inset-0 w-full h-full object-cover transition-opacity duration-700 ease-out {% if loop.first %}opacity-100{% else %}opacity-0{% endif %}" data-pin-img="{{ loop.index0 }}" src="{{ img }}" alt="{{ pinAlts[loop.index0] if pinAlts else '3D Studio' }}" width="1408" height="768" {% if loop.first %}fetchpriority="high" decoding="async"{% else %}loading="lazy" decoding="async"{% endif %} />
              {% endfor %}
              {# Kicker inside image bottom left like screenshot #}
              <div class="absolute bottom-0 left-0 right-0 p-6 lg:p-8 bg-gradient-to-t from-black/70 via-black/20 to-transparent">
                <h2 class="text-white text-[28px] lg:text-[32px] font-bold leading-[0.9] tracking-[-0.02em] max-w-[320px]">{{ kicker or 'See it. Understand it. Build it. — 3D Studio™' }}</h2>
              </div>
            </div>
          </div>

          {# Right card — cream with rounded 24px like screenshot #}
          <div class="lg:w-[48%] w-full">
            <div class="bg-[#f4efe7] lg:bg-[#efe8d8] rounded-[24px] p-6 lg:p-10 h-full flex flex-col relative min-h-[480px] lg:min-h-[520px] border border-black/[0.04]">
              {# Copies — only one visible at a time, no overlap #}
              <div class="relative flex-1">
                {% for copy in pinCopies %}
                <article class="lx-copy absolute inset-0 flex flex-col transition-all duration-700 ease-out {% if loop.first %}opacity-100 translate-y-0{% else %}opacity-0 translate-y-8 pointer-events-none{% endif %}" data-copy="{{ loop.index0 }}">
                  <div class="flex gap-5">
                    <div class="text-[64px] lg:text-[80px] font-black leading-none tracking-[-0.05em] text-[#d8c9a8] select-none">{{ copy.num }}</div>
                    <div class="flex-1 pt-2">
                      <h3 class="text-[20px] lg:text-[22px] font-bold leading-[1.1] tracking-tight text-navy">{{ copy.title }}</h3>
                      <p class="mt-4 text-[14px] leading-[1.6] text-black/60 max-w-[360px]">{{ copy.desc }}</p>
                      <div class="mt-8">
                        <a class="inline-flex items-center gap-3 bg-navy hover:bg-black text-white rounded-full px-5 py-3 text-[13px] font-semibold transition" href="{{ copy.link }}">
                          <span>{{ copy.btn }}</span>
                          <span class="w-6 h-6 rounded-full bg-white text-navy flex items-center justify-center"><svg viewBox="0 0 16 16" fill="none" class="w-3 h-3"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5"/></svg></span>
                        </a>
                      </div>
                    </div>
                  </div>
                </article>
                {% endfor %}
              </div>

              {# Thumbs + BOQ preview — bottom #}
              <div class="mt-auto pt-8 border-t border-black/5">
                <div class="flex items-center justify-between">
                  <div class="flex gap-3">
                    {% for img in pinImages %}
                    <button class="lx-thumb w-16 h-12 rounded-[12px] overflow-hidden relative flex-shrink-0 transition-all duration-300 {% if loop.first %}ring-2 ring-navy ring-offset-2 ring-offset-[#efe8d8]{% else %}opacity-60 hover:opacity-100{% endif %}" type="button" data-thumb="{{ loop.index0 }}" aria-label="Slide {{ loop.index }}">
                      <img src="{{ img }}" alt="" class="w-full h-full object-cover" loading="lazy" decoding="async" />
                    </button>
                    {% endfor %}
                  </div>
                  <div class="text-[11px] tracking-widest uppercase text-black/40 hidden lg:block">Studio</div>
                </div>
                {# BOQ preview next — like screenshot shows BOQ faint below #}
                <div class="mt-6 hidden lg:block opacity-40">
                  <div class="flex gap-4">
                    <div class="text-[48px] font-black leading-none text-[#d8c9a8]">BOQ</div>
                    <div class="text-[14px] leading-tight text-black/50 max-w-[200px]">Then money, if you want — 3D Studio™ to BOQ</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<script>
// Polished pin — no overlap, one copy at a time
(function(){
  const track = document.querySelector('.lx-pin-track');
  const prog = document.getElementById('lx-progress');
  const imgs = document.querySelectorAll('[data-pin-img]');
  const copies = document.querySelectorAll('[data-copy]');
  const thumbs = document.querySelectorAll('[data-thumb]');
  if(!track) return;
  let ticking=false;
  const setActive=(idx)=>{
    imgs.forEach((im,i)=>{ im.style.opacity = i===idx ? '1' : '0'; });
    copies.forEach((c,i)=>{
      if(i===idx){ c.style.opacity='1'; c.style.transform='translateY(0)'; c.style.pointerEvents='auto'; }
      else { c.style.opacity='0'; c.style.transform='translateY(16px)'; c.style.pointerEvents='none'; }
    });
    thumbs.forEach((t,i)=>{
      if(i===idx){ t.classList.add('ring-2','ring-navy','ring-offset-2','ring-offset-[#efe8d8]'); t.style.opacity='1'; }
      else { t.classList.remove('ring-2','ring-navy','ring-offset-2','ring-offset-[#efe8d8]'); t.style.opacity='0.6'; }
    });
  };
  const onScroll=()=>{
    if(ticking) return;
    ticking=true;
    requestAnimationFrame(()=>{
      const rect = track.getBoundingClientRect();
      const total = track.offsetHeight - window.innerHeight;
      const progress = Math.min(Math.max(-rect.top / total, 0), 1);
      if(prog) prog.style.width = (progress*100)+'%';
      const idx = Math.min(Math.floor(progress * imgs.length), imgs.length-1);
      setActive(idx);
      ticking=false;
    });
  };
  window.addEventListener('scroll', onScroll, {passive:true});
  thumbs.forEach(t=>{ t.addEventListener('click',()=>{ const i=parseInt(t.dataset.thumb||0); const targetTop = track.offsetTop + (i/imgs.length)* (track.offsetHeight - window.innerHeight); window.scrollTo({top:targetTop, behavior:'smooth'}); }); });
  setActive(0);
  onScroll();
})();
</script>
