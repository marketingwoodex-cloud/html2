{# Block 20: Featured Projects — Premium — Balanced Spacing — Animation #}
<!-- impeccable-disable all-caps-body, tiny-text -->
<section class="section-premium bg-white" data-anim="fade">
  <div class="container-wx">
    <div class="flex flex-wrap justify-between items-end gap-6 mb-10" data-anim="up">
      <div><p class="eyebrow" style="color:var(--wx-navy);">Featured studies — rooms drawn so they can be built</p><h2 class="mt-3" style="font-family:'Syne',sans-serif; font-size:clamp(1.6rem,3vw,2.2rem); line-height:1.2;">{{ heading or 'Studies — placeholder — real photography TBD' }}</h2></div>
      <a href="/projects/" class="btn btn-light" style="background:#fff; border:1px solid rgba(0,0,0,0.08);"><span class="btn-label"><span>All studies</span></span><span class="btn-icon" style="background:var(--wx-navy); color:#fff;"><svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5"/></svg></span></a>
    </div>
    <div class="grid grid-cols-12 gap-6 stagger" data-anim="up" data-delay="1">
      {% for proj in projects or [
        {"img":"/images/hero-1.jpg","title":"Corporate Office — Gulberg III","desc":"High-performing environment — brand, team, clients"},
        {"img":"/images/hero-2.jpg","title":"Software House — Talent Retention","desc":"Focus vs collaboration — demo room — 60/30/10"},
        {"img":"/images/hero-3.jpg","title":"Retail Showroom — Enter Pause Pay","desc":"Shop that can sell — customer journey"},
        {"img":"/images/project-facade.jpg","title":"Healthcare — Wellstar DHA Proof","desc":"Compliance, hygiene, patient flow — Wellstar proof"}
      ] %}
      <div class="col-span-12 md:col-span-6 lg:col-span-3">
        <a href="{{ proj.link or '/projects/' }}" class="card-premium group block overflow-hidden aspect-[4/3] bg-[#0f1e36] relative">
          <img src="{{ proj.img }}" alt="{{ proj.title }}" width="600" height="450" class="w-full h-full object-cover group-hover:scale-[1.05] transition duration-700" loading="lazy" decoding="async" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-5"><h3 class="text-white text-[15px] font-semibold leading-tight">{{ proj.title }}</h3><p class="text-white/60 text-[12px] mt-2 leading-[1.5]">{{ proj.desc }}</p></div>
        </a>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
