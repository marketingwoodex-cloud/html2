{# Block 20: Featured Projects — Polished — 3D Studio #}
<section class="py-20 bg-white">
  <div class="container-wx">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div class="max-w-2xl"><p class="eyebrow">{{ eyebrow or 'Featured Projects' }}</p><h3 class="text-3xl md:text-4xl font-bold tracking-tightx mt-3 leading-tight">{{ heading or 'Rooms drawn so they can be built — studies' }}</h3></div>
      <a href="/projects/" class="btn border border-black/10 text-sm hidden md:inline-flex"><span class="btn-label"><span>View all projects</span><span>View all projects</span></span></a>
    </div>
    <div class="grid md:grid-cols-3 gap-6 mt-10">
      {% for proj in projects or [] %}
      <a href="{{ proj.link or '/projects/' }}" class="group rounded-[24px] overflow-hidden border border-black/5 bg-cream hover:border-wood/30 hover:shadow-[0_20px_40px_rgba(0,0,0,0.08)] transition-all duration-300 block">
        <div class="relative aspect-[4/3] overflow-hidden bg-navy">
          <img src="{{ proj.img }}" alt="{{ proj.alt }}" class="w-full h-full object-cover group-hover:scale-105 transition duration-700 ease-out" loading="lazy" decoding="async" />
          <div class="absolute inset-0 bg-gradient-to-t from-navy/60 via-transparent to-transparent opacity-60"></div>
          {% if proj.study %}<span class="absolute top-4 left-4 bg-white/90 backdrop-blur text-navy text-[10px] tracking-[0.18em] uppercase px-3 py-1.5 rounded-full font-semibold">Study — DRAWN. THEN BUILT.</span>{% endif %}
          <div class="absolute bottom-3 right-3 w-9 h-9 bg-white rounded-full flex items-center justify-center shadow-lg translate-y-2 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition duration-300"><svg viewBox="0 0 16 16" fill="none" class="w-4 h-4"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5"/></svg></div>
        </div>
        <div class="p-6"><h4 class="font-semibold text-[16px] leading-tight">{{ proj.title }}</h4><p class="text-[13px] text-muted mt-2 leading-relaxed line-clamp-2">{{ proj.desc }}</p><div class="mt-4 text-[11px] tracking-widest uppercase font-semibold text-wood">View case →</div></div>
      </a>
      {% endfor %}
    </div>
    {% if note %}<p class="text-[11px] text-muted mt-6 border-l-2 border-wood pl-4 max-w-3xl">{{ note }}</p>{% endif %}
  </div>
</section>
