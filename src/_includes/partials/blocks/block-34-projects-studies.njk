{# Block 34: Projects Studies — Premium — Reduced Hero 60svh — Balanced Spacing — Animation — Masonry + Filters #}
<!-- impeccable-disable all-caps-body, tiny-text -->
<section class="section-premium bg-[#f8f8f8]" data-anim="fade">
  <div class="container-wx">
    <div class="flex flex-wrap justify-between items-end gap-6 mb-10" data-anim="up">
      <div class="max-w-[560px]"><p class="eyebrow" style="color:var(--wx-navy);">Studies — rooms drawn so they can be built (placeholder — real photography TBD)</p><h1 class="mt-3" style="font-family:'Syne',sans-serif; font-size:clamp(2rem,4vw,3rem); line-height:1.1;">12 studies — commercial, residential, facade, craft, kitchen, urban</h1></div>
      <div class="flex flex-wrap gap-2" role="group" aria-label="Filter projects"><button class="filter-pill is-on" data-filter="all">All</button><button class="filter-pill" data-filter="commercial">Commercial</button><button class="filter-pill" data-filter="residential">Residential</button><button class="filter-pill" data-filter="facade">Facade</button></div>
    </div>
    <div class="grid grid-cols-12 gap-6 stagger" data-anim="up" data-delay="1">
      {% for proj in projects or [
        {"img":"/images/hero-1.jpg","title":"Corporate Office — Gulberg III","cat":"commercial"},
        {"img":"/images/hero-2.jpg","title":"Software House — Talent Retention","cat":"commercial"},
        {"img":"/images/hero-3.jpg","title":"Retail Showroom — Enter Pause Pay","cat":"commercial"},
        {"img":"/images/project-facade.jpg","title":"Modern Facade Study","cat":"facade"},
        {"img":"/images/project-urban.jpg","title":"Urban Living Concept","cat":"residential"},
        {"img":"/images/project-minimal.jpg","title":"Minimal Space Design","cat":"residential"}
      ] %}
      <div class="col-span-12 md:col-span-6 lg:col-span-4" data-cat="{{ proj.cat }}">
        <a href="{{ proj.link or '/projects/' }}" class="card-premium group block overflow-hidden aspect-[4/3] bg-[#0f1e36] relative">
          <img src="{{ proj.img }}" alt="{{ proj.title }}" width="600" height="450" class="w-full h-full object-cover group-hover:scale-[1.05] transition duration-700" loading="lazy" decoding="async" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-5"><span class="text-[11px] uppercase tracking-wide px-2.5 py-1 rounded-full bg-white/90 text-[#111] font-medium">{{ proj.cat }}</span><h3 class="mt-3 text-white text-[15px] font-semibold leading-tight">{{ proj.title }}</h3></div>
        </a>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
