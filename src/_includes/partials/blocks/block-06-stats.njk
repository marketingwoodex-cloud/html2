{# Block 06: Stats — Premium V2 — Unique Height 60svh — Reduced Content — Fixed ~10 — Spacing — Aligned — Responsive #}
<!-- impeccable-disable all-caps-body, tiny-text -->
<section class="section-premium {% if dark %}bg-[#0f1e36] text-white{% else %}bg-[#fcf2e8]{% endif %}" data-anim="fade" style="min-height:60svh;">
  <div class="container-wx">
    <div class="max-w-[560px] mb-10" data-anim="up">
      <p class="eyebrow" style="{% if dark %}color:rgba(255,255,255,0.5);{% else %}color:var(--wx-navy);{% endif %}">{{ eyebrow or 'One team. One process. One result.' }}</p>
      <h2 class="mt-3" style="font-family:'Syne',sans-serif; font-size:clamp(1.6rem,3vw,2rem); line-height:1.2; {% if dark %}color:#fff;{% endif %} max-width:22ch;">{{ heading or 'Discover → Deliver — Stop at gate you choose' }}</h2>
    </div>
    <div class="grid grid-cols-12 gap-5 stagger" data-anim="up" data-delay="1">
      {% for stat in stats or [] %}
      <div class="col-span-12 md:col-span-6 lg:col-span-3">
        <article class="card-premium p-7 h-full min-h-[200px] flex flex-col {% if stat.accent %}bg-[#0f1e36] text-white border-white/10{% elif dark %}bg-white/5 border-white/10 text-white{% else %}bg-white{% endif %}" data-anim="up" data-delay="{{ loop.index }}">
          <div class="text-[44px] font-semibold leading-none" style="font-family:'Syne',sans-serif; color:{% if stat.accent or dark %}#fcf2e8{% else %}var(--wx-navy){% endif %}; line-height:1.1;">{{ stat.num | replace("~","") }}</div>
          <div class="mt-8"><h3 class="text-[16px] font-semibold leading-tight" style="font-family:'Syne',sans-serif;">{{ stat.title }}</h3><p class="mt-2 text-[13px] leading-[1.5] line-clamp-3" style="{% if stat.accent or dark %}color:rgba(255,255,255,0.7);{% else %}color:var(--wx-charcoal);{% endif %}">{{ stat.desc }}</p></div>
        </article>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
