          <span class="ico" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M16 21V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v16"/><rect x="2" y="7" width="20" height="14" rx="2"/></svg></span>
