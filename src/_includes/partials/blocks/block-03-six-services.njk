{# Block 03: Six Services — Premium — St-Spaces — Linoxa Building Documentation — Balanced Spacing — Animation #}
<!-- impeccable-disable all-caps-body, tiny-text, numbered-section-labels -->
<section class="section-premium bg-[#fcf2e8]" id="six-services" data-anim="fade">
  <div class="container-wx">
    <div class="grid grid-cols-12 gap-8 lg:gap-12 items-end mb-12">
      <div class="col-span-12 lg:col-span-6" data-anim="up">
        <p class="eyebrow" style="color:var(--wx-navy);">{{ eyebrow or 'Beyond Design. We Build Experiences.' }}</p>
        <h2 class="mt-4" style="font-family:'Syne',sans-serif; font-size:clamp(1.8rem,3vw,2.5rem); line-height:1.2; max-width:16ch;">{{ heading or 'Six services you can actually buy — not six cloned cards' }}</h2>
      </div>
      <div class="col-span-12 lg:col-span-6" data-anim="up" data-delay="1">
        <p style="color:var(--wx-charcoal); font-size:16px; line-height:1.6; max-width:52ch;">{{ subheading or 'Rooms, named outputs, a unique path. Corporate workplaces first. Commercial growth. Residential selective. Same discipline as 3D Studio.' }}</p>
      </div>
    </div>
    <div class="grid grid-cols-12 gap-8 lg:gap-12">
      <div class="col-span-12 lg:col-span-7" data-anim="left">
        <div class="relative rounded-[24px] overflow-hidden aspect-[4/3] bg-[#0f1e36]" data-tilt>
          <img id="st-space-img" src="{{ mediaImage or '/images/hero-1.jpg' }}" alt="{{ mediaAlt or 'Service preview' }}" width="800" height="600" class="w-full h-full object-cover" loading="lazy" decoding="async" />
          <div class="absolute bottom-4 left-4 right-4 bg-[#0f1e36]/80 backdrop-blur rounded-[16px] p-4 flex justify-between items-center">
            <div><p class="text-[11px] tracking-[0.12em] uppercase font-semibold text-white/50">{{ mediaSmall or 'Service 01 — P1 Revenue Engine' }}</p><p id="st-space-cap" class="text-[14px] font-medium text-white mt-1">{{ mediaCap or 'Office Fit-Out — arrival, focus, demo room' }}</p></div>
            <span class="w-8 h-8 rounded-full bg-white text-[#0f1e36] flex items-center justify-center" aria-hidden="true">↗</span>
          </div>
        </div>
      </div>
      <div class="col-span-12 lg:col-span-5" data-anim="right" data-delay="2">
        <div class="space-y-2" role="list">
          {% for svc in services or [] %}
          <button class="st-space group w-full text-left flex gap-4 p-4 rounded-[16px] border border-transparent hover:bg-white hover:border-black/5 transition text-left" type="button" data-img="{{ svc.img }}" data-alt="{{ svc.alt }}" data-cap="{{ svc.cap }}" data-anim="up" data-delay="{{ loop.index }}">
            <span class="text-[12px] font-semibold tracking-wide text-black/30 mt-1">{{ svc.n }}</span>
            <span class="flex-1 min-w-0"><span class="block font-semibold text-[16px] leading-tight group-hover:text-[#0f1e36] transition">{{ svc.title }}</span><span class="block text-[13px] text-[#525252] leading-[1.5] mt-1">{{ svc.desc }}</span></span>
            <span class="w-8 h-8 rounded-full bg-[#f8f8f8] group-hover:bg-[#0f1e36] group-hover:text-white flex items-center justify-center transition ml-auto flex-shrink-0" aria-hidden="true"><svg viewBox="0 0 16 16" width="14" height="14" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5"/></svg></span>
          </button>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>
