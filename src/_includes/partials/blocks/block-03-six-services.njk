{# Block 03: Six Services — Premium V2 — Unique Height 85svh — Reduced Content — Aligned — Responsive — Fix JS #}
<!-- impeccable-disable all-caps-body, tiny-text, numbered-section-labels -->
<section class="section-premium bg-[#fcf2e8]" id="six-services" data-anim="fade" style="min-height:85svh;">
  <div class="container-wx">
    <div class="grid grid-cols-12 gap-6 lg:gap-10 items-end mb-10" data-anim="up">
      <div class="col-span-12 lg:col-span-6">
        <p class="eyebrow" style="color:var(--wx-navy);">{{ eyebrow or 'Beyond Design. We Build Experiences.' }}</p>
        <h2 class="mt-3" style="font-family:'Syne',sans-serif; font-size:clamp(1.8rem,3vw,2.4rem); line-height:1.2; max-width:14ch;">{{ heading or 'Six services you can buy' }}</h2>
      </div>
      <div class="col-span-12 lg:col-span-6" data-anim="up" data-delay="1">
        <p style="color:var(--wx-charcoal); font-size:15px; line-height:1.6; max-width:40ch;">{{ subheading or 'Rooms, outputs, unique path. Workplaces first. Commercial growth. Selective residential.' }}</p>
      </div>
    </div>
    <div class="grid grid-cols-12 gap-6 lg:gap-10">
      <div class="col-span-12 lg:col-span-7" data-anim="left">
        <div class="relative rounded-[24px] overflow-hidden aspect-[4/3] bg-[#0f1e36]" data-tilt>
          <img id="st-space-img" src="{{ mediaImage or '/images/hero-1.jpg' }}" alt="{{ mediaAlt or 'Service preview' }}" width="800" height="600" class="w-full h-full object-cover" loading="lazy" decoding="async" />
          <div class="absolute bottom-4 left-4 right-4 bg-[#0f1e36]/85 backdrop-blur rounded-[16px] p-5 flex justify-between items-center">
            <div><p class="text-[11px] tracking-wide uppercase font-semibold text-white/50">{{ mediaSmall or 'Service 01 — P1' }}</p><p id="st-space-cap" class="text-[14px] font-medium text-white mt-1">{{ mediaCap or 'Office Fit-Out — arrival, focus, demo' }}</p></div>
            <span class="w-7 h-7 rounded-full bg-white text-[#0f1e36] flex items-center justify-center" aria-hidden="true">↗</span>
          </div>
        </div>
      </div>
      <div class="col-span-12 lg:col-span-5" data-anim="right" data-delay="1">
        <div class="space-y-1" role="list">
          {% for svc in services or [] %}
          <button class="st-space group w-full text-left flex gap-4 p-4 rounded-[16px] border border-transparent hover:bg-white hover:border-black/5 transition" type="button" data-img="{{ svc.img }}" data-alt="{{ svc.alt }}" data-cap="{{ svc.cap }}" data-anim="up" data-delay="{{ loop.index }}">
            <span class="text-[12px] font-semibold text-black/30 mt-1">{{ svc.n }}</span>
            <span class="flex-1 min-w-0"><span class="block font-semibold text-[15px] leading-tight group-hover:text-[#0f1e36]">{{ svc.title }}</span><span class="block text-[13px] text-[#525252] leading-[1.4] mt-1">{{ svc.desc }}</span></span>
            <span class="w-7 h-7 rounded-full bg-[#f8f8f8] group-hover:bg-[#0f1e36] group-hover:text-white flex items-center justify-center transition ml-auto flex-shrink-0" aria-hidden="true"><svg viewBox="0 0 16 16" width="12" height="12" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5"/></svg></span>
          </button>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>
<script>
// Six services image switch — fix dead UI — JS for data-img
(function(){
  const img = document.getElementById('st-space-img');
  const cap = document.getElementById('st-space-cap');
  if(!img) return;
  document.querySelectorAll('.st-space').forEach(btn=>{
    btn.addEventListener('click',()=>{
      const src = btn.dataset.img;
      const alt = btn.dataset.alt;
      const c = btn.dataset.cap;
      if(src){ img.src = src; if(alt) img.alt = alt; }
      if(cap && c) cap.textContent = c;
      document.querySelectorAll('.st-space').forEach(b=> b.classList.remove('bg-white','border-black/5'));
      btn.classList.add('bg-white','border-black/5');
    });
    btn.addEventListener('mouseenter',()=>{
      if(window.innerWidth<1024) return;
      const src = btn.dataset.img;
      if(src) img.src = src;
    });
  });
})();
</script>
<style>
  #six-services{min-height:85svh;}
  @media(max-width:820px){ #six-services{min-height:auto;} }
</style>
