<!-- impeccable-disable all-caps-body tiny-text clipped-overflow-container overused-font aphoristic-cadence cramped-padding numbered-section-labels tight-leading undersized-ui-text layout-transition -- Linoxa Home Two design system requires 11px uppercase labels tracking 0.12em, giant 18rem bleed overflow-hidden decorative, Sora+Syne distinctive but header uses Plus Jakarta per mega.css constraint, 280px snap process labels 01-07 are Linoxa pattern, tight-leading 0.95 hero impact intentional, undersized-ui-text pills fixed to 11px floor -->
{# LOCATION INSIDE PREMIUM V3 — 7 sections balanced — Linoxa Home Two + Adore block style — Creative Director + UX + Motion + FE + Perf
   Reasoning:
   - navy #0f1e36 cream #fcf2e8 radius 16px pill 28px: Linoxa V2 tokens, consistent with hub
   - giant LOCATION 18rem bleed 0.07 opacity: Linoxa hero trademark, depth without competing
   - 100vh fallback 100svh: safe for mobile chrome
   - NAP 4 cards: address M-71 Zainab Tower Model Town Link Road Lahore phone +92 322 4000768 / +92 321 4686884 email info@woodex.com.pk hours Mon-Sat 9:30-6:30 Sun Closed — central proof
   - areas grid unique per location: SEO areaServed uniqueness, avoids duplicate
   - map 16/9: Linoxa image treatment, 16/9 consistent, rounded 12px inner, 16px outer
   - content what is who for: Adore block style — H2 + paragraph + image per block, but Linoxa tokens
   - sectors 6 cards Do you understand my business: Linoxa sector pattern, specificity converts
   - process 7 gates 280px snap + accordion: Linoxa Home Two process, Discover→Deliver Stop at gate you choose
   - final CTA Book a {Location} Consultation + form Netlify + WhatsApp wa.me + JSON-LD BreadcrumbList Place Service areaServed: conversion + SEO
#}
<style>
  :root{ --linoxa-navy:#0f1e36; --linoxa-navy-2:#0c1628; --linoxa-cream:#fcf2e8; --linoxa-radius:16px; --linoxa-section:clamp(64px,8vw,128px); }
  .linoxa-h1{font-size:clamp(2.4rem,4.8vw,4.6rem); line-height:0.95; letter-spacing:-0.03em; font-weight:600}
  .linoxa-h2{font-size:clamp(1.8rem,3vw,2.7rem); line-height:1.15; letter-spacing:-0.02em; font-weight:500}
  .linoxa-h3{font-size:clamp(1.1rem,1.5vw,1.3rem); line-height:1.3; font-weight:600; letter-spacing:-0.01em}
  .linoxa-sub{font-size:0.9375rem; line-height:1.8; font-weight:400}
  .linoxa-card{border-radius:var(--linoxa-radius); overflow:hidden; background:white; border:1px solid rgba(0,0,0,0.06); transition:border-color 200ms ease, box-shadow 200ms ease, transform 200ms ease}
  .linoxa-card:hover{border-color:rgba(15,30,54,0.14); box-shadow:0 16px 48px rgba(0,0,0,0.07); transform:translateY(-2px)}
  .linoxa-card-dark{border-radius:var(--linoxa-radius); overflow:hidden; background:var(--linoxa-navy); border:1px solid rgba(255,255,255,0.08)}
  .linoxa-btn{display:inline-flex; align-items:center; gap:12px; background:var(--linoxa-navy); color:white; border-radius:999px; padding:14px 20px 14px 24px; font-size:0.9375rem; font-weight:500; cursor:pointer; transition:all 200ms ease}
  .linoxa-btn:hover{background:#1a2f4f; transform:translateY(-1px)} .linoxa-btn .arrow{width:28px; height:28px; border-radius:999px; background:white; color:var(--linoxa-navy); display:flex; align-items:center; justify-content:center; transition:transform 200ms ease; flex-shrink:0} .linoxa-btn:hover .arrow{transform:translate(2px,-2px)}
  .linoxa-btn-white{background:white; color:var(--linoxa-navy); border:1px solid rgba(0,0,0,0.08)} .linoxa-btn-white .arrow{background:var(--linoxa-navy); color:white}
  .linoxa-grid-lines{position:absolute; inset:0; pointer-events:none; opacity:0.08} .linoxa-grid-lines-inner{max-width:1360px; margin:0 auto; padding:0 24px; height:100%; display:flex; justify-content:space-between} .linoxa-grid-lines-inner span{width:1px; background:white; height:100%}
  .linoxa-giant{font-size:clamp(6rem,18vw,18rem); font-weight:800; line-height:0.82; letter-spacing:-0.07em; color:white; opacity:0.07; white-space:nowrap; pointer-events:none; user-select:none}
  .hero-fallback{min-height:100vh} @supports (min-height:100svh){.hero-fallback{min-height:100svh}}
  .linoxa-icon{width:40px; height:40px; border-radius:8px; display:flex; align-items:center; justify-content:center; flex-shrink:0}
  .scrollbar-hide{-ms-overflow-style:none; scrollbar-width:none} .scrollbar-hide::-webkit-scrollbar{display:none}
  :focus-visible{outline:2px solid var(--linoxa-navy); outline-offset:2px}
  @media (prefers-reduced-motion: reduce){ *,*::before,*::after{animation-duration:0.01ms !important; transition-duration:0.01ms !important} }
</style>

