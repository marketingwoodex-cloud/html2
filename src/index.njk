    const h = document.documentElement;
    const scrolled = (h.scrollTop / (h.scrollHeight - h.clientHeight)) * 100;
    if(bar) bar.style.width = scrolled + '%';
  };
  window.addEventListener('scroll', onScroll, {passive:true});
  onScroll();

  // Hero parallax layers
  const hero = document.getElementById('hero');
  const layers = document.querySelectorAll('.layer[data-depth]');
  if(hero && layers.length && window.matchMedia('(prefers-reduced-motion: no-preference)').matches){
    hero.addEventListener('mousemove', (e)=>{
      const rect = hero.getBoundingClientRect();
      const x = (e.clientX - rect.left) / rect.width - 0.5;
      const y = (e.clientY - rect.top) / rect.height - 0.5;
      layers.forEach(l=>{
        const d = parseFloat(l.dataset.depth||0);
        l.style.transform = `translate3d(${x * d * 100}px, ${y * d * 80}px, 0)`;
      });
    });
    hero.addEventListener('mouseleave', ()=>{
      layers.forEach(l=> l.style.transform = 'translate3d(0,0,0)');
    });
  }

  // Tilt
  document.querySelectorAll('[data-tilt]').forEach(el=>{
    if(window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    el.addEventListener('mousemove', (e)=>{
      const rect = el.getBoundingClientRect();
      const x = (e.clientX - rect.left) / rect.width - 0.5;
      const y = (e.clientY - rect.top) / rect.height - 0.5;
      el.style.transform = `perspective(1000px) rotateY(${x * 8}deg) rotateX(${-y * 8}deg)`;
    });
    el.addEventListener('mouseleave', ()=> el.style.transform = 'perspective(1000px) rotateY(0) rotateX(0)');
  });

  // Services switch
  const svcImg = document.getElementById('svc-img');
  const svcCap = document.getElementById('svc-cap');
  document.querySelectorAll('.svc-btn').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      const src = btn.dataset.img;
      const cap = btn.dataset.cap;
      if(svcImg && src) svcImg.src = src;
      if(svcCap && cap) svcCap.textContent = cap;
      document.querySelectorAll('.svc-btn').forEach(b=> b.classList.remove('bg-white','border-black/5'));
      btn.classList.add('bg-white','border-black/5');
    });
  });

  // Pin
  const track = document.querySelector('.lx-pin-track');
  const prog = document.getElementById('lx-progress');
  const imgs = document.querySelectorAll('[data-pin-img]');
  const copies = document.querySelectorAll('[data-copy]');
  const thumbs = document.querySelectorAll('[data-thumb]');
  if(track){
    let ticking=false;
    const setActive=(idx)=>{
      imgs.forEach((im,i)=> im.style.opacity = i===idx ? '1' : '0');
      copies.forEach((c,i)=>{
        if(i===idx){ c.style.opacity='1'; c.style.transform='translateY(0)'; c.style.pointerEvents='auto'; }
        else { c.style.opacity='0'; c.style.transform='translateY(16px)'; c.style.pointerEvents='none'; }
      });
      thumbs.forEach((t,i)=>{
        if(i===idx){ t.classList.add('ring-2','ring-[#0f1e36]','ring-offset-2'); t.style.opacity='1'; }
        else { t.classList.remove('ring-2','ring-[#0f1e36]','ring-offset-2'); t.style.opacity='0.6'; }
      });
    };
    const onScrollPin=()=>{
      if(ticking) return;
      ticking=true;
      requestAnimationFrame(()=>{
        const rect = track.getBoundingClientRect();
        const total = track.offsetHeight - window.innerHeight;
        const progress = Math.min(Math.max(-rect.top / total, 0), 1);
        if(prog) prog.style.width = (progress*100)+'%';
        const idx = Math.min(Math.floor(progress * imgs.length), imgs.length-1);
        setActive(idx);
        ticking=false;
      });
    };
    window.addEventListener('scroll', onScrollPin, {passive:true});
    thumbs.forEach(t=> t.addEventListener('click', ()=>{
      const i=parseInt(t.dataset.thumb||0);
      const targetTop = track.offsetTop + (i/imgs.length)*(track.offsetHeight - window.innerHeight);
      window.scrollTo({top:targetTop, behavior:'smooth'});
    }));
    setActive(0);
    onScrollPin();
  }

  // Reveal
  const anims = document.querySelectorAll('[data-anim]');
  if('IntersectionObserver' in window){
    const io = new IntersectionObserver(entries=>{
      entries.forEach(entry=>{
        if(entry.isIntersecting){
          entry.target.classList.add('in');
          io.unobserve(entry.target);
        }
      });
    }, {threshold:0.15});
    anims.forEach(el=> io.observe(el));
  } else {
    anims.forEach(el=> el.classList.add('in'));
  }

  // Hero in
  document.getElementById('hero')?.classList.add('is-in');
})();
</script>
