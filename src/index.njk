<script>
// Home interactions — fixed alignment, no broken design
(function(){
  const bar = document.getElementById('home-progress');
  window.addEventListener('scroll', ()=>{
    const h = document.documentElement;
    const scrolled = (h.scrollTop / (h.scrollHeight - h.clientHeight)) * 100;
    if(bar) bar.style.width = scrolled + '%';
  }, {passive:true});

  // Services switch
  const svcImg = document.getElementById('home-svc-img');
  const svcCap = document.getElementById('home-svc-cap');
  document.querySelectorAll('.home-svc-btn').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      const src = btn.dataset.img;
      const cap = btn.dataset.cap;
      if(svcImg && src) svcImg.src = src;
      if(svcCap && cap) svcCap.textContent = cap;
      document.querySelectorAll('.home-svc-btn').forEach(b=>{
        b.style.background='#transparent';
        b.style.borderColor='transparent';
      });
      btn.style.background='#fff';
      btn.style.borderColor='rgba(0,0,0,0.06)';
    });
  });

  // Pin
  const track = document.querySelector('.home-pin-track');
  const prog = document.getElementById('home-pin-progress');
  const imgs = document.querySelectorAll('[data-home-pin]');
  const copies = document.querySelectorAll('[data-home-copy]');
  const thumbs = document.querySelectorAll('[data-home-thumb]');
  if(track){
    let ticking=false;
    const setActive=(idx)=>{
      imgs.forEach((im,i)=> im.style.opacity = i===idx ? '1' : '0');
      copies.forEach((c,i)=>{
        if(i===idx){ c.style.opacity='1'; c.style.transform='translateY(0)'; c.style.pointerEvents='auto'; }
        else { c.style.opacity='0'; c.style.transform='translateY(16px)'; c.style.pointerEvents='none'; }
      });
      thumbs.forEach((t,i)=>{
        if(i===idx){ t.style.borderColor='#0f1e36'; t.style.opacity='1'; }
        else { t.style.borderColor='transparent'; t.style.opacity='0.6'; }
      });
    };
    const onScroll=()=>{
      if(ticking) return;
      ticking=true;
      requestAnimationFrame(()=>{
        const rect = track.getBoundingClientRect();
        const total = track.offsetHeight - window.innerHeight;
        const progress = Math.min(Math.max(-rect.top / total, 0), 1);
        if(prog) prog.style.width = (progress*100)+'%';
        const idx = Math.min(Math.floor(progress * imgs.length), imgs.length-1);
        setActive(idx);
        ticking=false;
      });
    };
    window.addEventListener('scroll', onScroll, {passive:true});
    thumbs.forEach(t=> t.addEventListener('click', ()=>{
      const i=parseInt(t.dataset.thumb||0);
      const targetTop = track.offsetTop + (i/imgs.length)*(track.offsetHeight - window.innerHeight);
      window.scrollTo({top:targetTop, behavior:'smooth'});
    }));
    setActive(0);
    onScroll();
  }

  // FAQ
  document.querySelectorAll('.home-faq button').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      const item = btn.closest('.home-faq');
      const isOpen = item.classList.contains('is-open');
      document.querySelectorAll('.home-faq').forEach(i=>{
        i.classList.remove('is-open');
        const a = i.querySelector('div');
        if(a) a.style.display='none';
      });
      if(!isOpen){
        item.classList.add('is-open');
        const a = item.querySelector('div');
        if(a) a.style.display='block';
      }
    });
  });

  // Reveal
  const anims = document.querySelectorAll('[data-anim]');
  if('IntersectionObserver' in window){
    const io = new IntersectionObserver(entries=>{
      entries.forEach(entry=>{
        if(entry.isIntersecting){
          entry.target.classList.add('in');
          io.unobserve(entry.target);
        }
      });
    }, {threshold:0.15});
    anims.forEach(el=> io.observe(el));
  } else {
    anims.forEach(el=> el.classList.add('in'));
  }
})();
</script>
