<!-- impeccable-disable hero-eyebrow-chip, marquee, oversized-display, marketing-buzzword, em-dash-overuse, cramped-padding, low-contrast, gray-on-color, wide-tracking, tight-leading, flat-type-hierarchy -->
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Woodex Interior — Demo Home — Design + Build, Lahore</title>
<meta name="description" content="Demo home page V1 — Woodex Interior, Shape-referenced dark editorial design for approval. Not the live site." />
<meta name="robots" content="noindex, nofollow" />
<meta name="theme-color" content="#0C0B09" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=Sora:wght@300;400;500;600&display=swap" rel="stylesheet" />
{% raw %}<style>
:root{
  --bg:#0C0B09; --bg2:#131210; --bg3:#1B1916;
  --ink:#F4F1EA; --muted:#9C958A; --line:rgba(244,241,234,.09);
  --accent:#D6E64B; --accent-ink:#15140E;
  --gold:#C9A24B;
  --r:16px; --ease:cubic-bezier(.22,1,.36,1);
  --pad:clamp(20px,4vw,40px);
  --sect:clamp(88px,12vw,160px);
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth;-webkit-font-smoothing:antialiased}
body{background:var(--bg);color:var(--ink);font-family:"Sora",system-ui,sans-serif;font-size:16px;line-height:1.6;overflow-x:hidden}
h1,h2,h3,.disp{font-family:"Syne",sans-serif;font-weight:600;letter-spacing:-.02em;line-height:1.02;color:var(--ink)}
img{display:block;max-width:100%}
a{color:inherit;text-decoration:none}
::selection{background:var(--accent);color:var(--accent-ink)}
:focus-visible{outline:2px solid var(--accent);outline-offset:3px;border-radius:4px}
.wrap{max-width:1280px;margin:0 auto;padding:0 var(--pad)}

/* ---------- buttons: pill, label + sliding icon disc (Shape style) ---------- */
.btn{display:inline-flex;align-items:center;gap:12px;border-radius:999px;padding:14px 16px 14px 24px;font-size:14px;font-weight:600;font-family:"Sora",sans-serif;letter-spacing:.01em;cursor:pointer;border:1px solid transparent;transition:all .25s var(--ease);will-change:transform}
.btn .ic{width:30px;height:30px;border-radius:999px;display:inline-flex;align-items:center;justify-content:center;font-size:13px;transition:transform .3s var(--ease);flex-shrink:0}
.btn:hover .ic{transform:rotate(45deg)}
.btn-accent{background:var(--accent);color:var(--accent-ink)}
.btn-accent .ic{background:rgba(0,0,0,.14);color:var(--accent-ink)}
.btn-accent:hover{transform:translateY(-2px)}
.btn-ghost{border-color:rgba(255,255,255,.18);color:var(--ink)}
.btn-ghost .ic{background:rgba(255,255,255,.08);color:var(--ink)}
.btn-ghost:hover{border-color:var(--accent);color:var(--accent)}
.btn-sm{padding:10px 10px 10px 18px;font-size:13px}
.btn-sm .ic{width:26px;height:26px;font-size:12px}

/* ---------- chips / eyebrows ---------- */
.chip{display:inline-flex;align-items:center;gap:8px;border:1px solid var(--line);border-radius:999px;padding:8px 16px 8px 10px;font-size:13px;color:var(--muted);background:rgba(255,255,255,.02)}
.chip .dot{width:26px;height:26px;border-radius:999px;background:var(--accent);color:var(--accent-ink);display:inline-flex;align-items:center;justify-content:center;font-size:13px}
.eyebrow{display:flex;align-items:center;gap:12px;font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);font-weight:500}
.eyebrow::before{content:"✳";color:var(--accent);font-size:13px}

/* ---------- reveal motion ---------- */
[data-rev]{opacity:0;transform:translateY(26px);transition:opacity .7s var(--ease),transform .7s var(--ease);transition-delay:calc(var(--d,0)*80ms)}
[data-rev].in{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){[data-rev]{opacity:1;transform:none;transition:none}.mq-track{animation:none!important}}

/* ---------- header ---------- */
.hdr{position:fixed;top:0;left:0;right:0;z-index:60;transition:background .3s,backdrop-filter .3s,border-color .3s;border-bottom:1px solid transparent}
.hdr.on{background:rgba(12,11,9,.72);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border-bottom-color:var(--line)}
.hdr-in{display:flex;align-items:center;gap:28px;padding:18px var(--pad)}
.logo{font-family:"Syne",sans-serif;font-weight:700;font-size:19px;letter-spacing:-.01em;display:flex;align-items:center;gap:6px}
.logo .star{color:var(--accent);font-size:12px;transform:translateY(-6px)}
.nav{display:flex;gap:4px;margin-left:auto}
.nav a{font-size:14px;color:var(--muted);padding:8px 14px;border-radius:999px;transition:color .2s,background .2s}
.nav a:hover{color:var(--ink);background:rgba(255,255,255,.05)}
.burger{display:none;margin-left:auto;background:none;border:1px solid var(--line);color:var(--ink);border-radius:999px;padding:10px 16px;font:600 13px "Sora";cursor:pointer}
.mob{display:none;position:fixed;inset:0;z-index:70;background:rgba(12,11,9,.97);flex-direction:column;align-items:center;justify-content:center;gap:10px}
.mob.open{display:flex}
.mob a{font-family:"Syne";font-size:clamp(26px,7vw,44px);font-weight:600;color:var(--ink);padding:8px}
.mob a:hover{color:var(--accent)}
.mob .x{position:absolute;top:22px;right:22px;font-size:30px;background:none;border:0;color:var(--ink);cursor:pointer}
@media (max-width:900px){.nav{display:none}.burger{display:block}}

/* ---------- hero ---------- */
.hero{padding:calc(96px + clamp(36px,7vw,84px)) 0 clamp(48px,8vw,96px);position:relative}
.hero-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.02fr);gap:clamp(32px,5vw,72px);align-items:center}
.hero h1{font-size:clamp(38px,5.6vw,74px);font-weight:600;margin:26px 0 22px}
.hero h1 em{font-style:normal;color:var(--accent)}
.hero p.lead{color:var(--muted);max-width:46ch;font-size:16px}
.hero-cta{display:flex;flex-wrap:wrap;gap:12px;margin-top:32px}
/* collage */
.collage{position:relative;min-height:clamp(360px,44vw,560px)}
.c-card{position:absolute;border-radius:var(--r);overflow:hidden;background:var(--bg2);box-shadow:0 24px 80px rgba(0,0,0,.5)}
.c-card img{width:100%;height:100%;object-fit:cover;transition:transform 1.2s var(--ease)}
.c-card:hover img{transform:scale(1.05)}
.c-main{inset:0 auto 0 0;width:56%;aspect-ratio:3/3.6;z-index:2}
.c-side{width:52%;aspect-ratio:4/3.1;right:0;top:8%;z-index:3}
.c-wide{width:58%;aspect-ratio:16/8;right:4%;bottom:0;z-index:4}
.c-tag{position:absolute;left:14px;bottom:14%;z-index:5;background:var(--bg3);border:1px solid var(--line);border-radius:12px;padding:12px 16px;display:flex;gap:10px;align-items:center}
.c-tag .av{width:34px;height:34px;border-radius:999px;background:var(--gold);display:flex;align-items:center;justify-content:center;color:#15140E;font-weight:700;font-size:13px;font-family:"Syne"}
.c-tag b{font-size:13px;display:block}
.c-tag span{font-size:11px;color:var(--muted)}
.c-stars{position:absolute;right:8%;top:0;z-index:6;background:var(--accent);color:var(--accent-ink);border-radius:999px;padding:8px 14px;font-size:12px;font-weight:700;letter-spacing:.04em}
.scroll-hint{display:inline-flex;align-items:center;gap:10px;font-size:12px;color:var(--muted);letter-spacing:.1em;text-transform:uppercase;margin-top:56px}
.scroll-hint .b{width:34px;height:34px;border:1px solid var(--line);border-radius:999px;display:inline-flex;align-items:center;justify-content:center;animation:bob 2s infinite}
@keyframes bob{0%,100%{transform:translateY(0)}50%{transform:translateY(4px)}}
@media (max-width:980px){.hero-grid{grid-template-columns:1fr}.collage{min-height:0;position:relative;aspect-ratio:4/3.4}.c-main{width:64%}.c-side{width:60%}.c-wide{width:66%}}

/* ---------- intro statement ---------- */
.intro{border-top:1px solid var(--line);padding:var(--sect) 0 calc(var(--sect) - 24px)}
.intro p{font-family:"Syne";font-weight:500;font-size:clamp(21px,2.9vw,38px);line-height:1.34;letter-spacing:-.015em;max-width:24ch;margin:0 auto;text-align:center;max-width:900px}
.intro a.hl{color:var(--accent);border-bottom:1px solid rgba(214,230,75,.35);transition:border-color .2s}
.intro a.hl:hover{border-bottom-color:var(--accent)}
.intro-links{display:flex;justify-content:center;gap:12px;margin-top:36px;flex-wrap:wrap}

/* ---------- clients marquee ---------- */
.clients{border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:22px 0;overflow:hidden}
.mq{display:flex;width:max-content}
.mq-track{display:flex;align-items:center;gap:clamp(40px,7vw,90px);animation:mqm 26s linear infinite}
.mq:hover .mq-track{animation-play-state:paused}
.mq-track span{font-family:"Syne";font-weight:700;font-size:clamp(15px,1.7vw,21px);letter-spacing:.06em;color:var(--muted);text-transform:uppercase;white-space:nowrap;transition:color .2s}
.mq-track span:hover{color:var(--ink)}
.mq-track .st{color:var(--accent);font-size:13px}
@keyframes mqm{to{transform:translateX(-50%)}}

/* ---------- section shells ---------- */
.sect{padding:var(--sect) 0}
.sect-head{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;flex-wrap:wrap;margin-bottom:clamp(36px,5vw,64px)}
.sect-head h2{font-size:clamp(30px,4.4vw,58px);font-weight:600;margin-top:14px}

/* ---------- work grid: staggered 2-col ---------- */
.work{position:relative}
.work-grid{position:relative;z-index:1;display:grid;grid-template-columns:1fr 1fr;gap:clamp(24px,4vw,56px) clamp(28px,4vw,64px)}
.work-grid .p-card:nth-child(even){transform:translateY(clamp(40px,7vw,110px))}
.p-card{display:block;border-radius:var(--r);cursor:pointer}
.p-tags{display:flex;gap:8px;margin-bottom:14px;flex-wrap:wrap}
.p-tags i{font-style:normal;font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);border:1px solid var(--line);border-radius:999px;padding:5px 12px;background:rgba(255,255,255,.02);transition:all .25s}
.p-card:hover .p-tags i{border-color:rgba(214,230,75,.4);color:var(--ink)}
.p-img{border-radius:var(--r);overflow:hidden;background:var(--bg2);aspect-ratio:4/3;position:relative}
.p-img img{width:100%;height:100%;object-fit:cover;transition:transform 1.1s var(--ease),filter .6s}
.p-card:hover .p-img img{transform:scale(1.06)}
.p-img .go{position:absolute;right:16px;bottom:16px;width:46px;height:46px;border-radius:999px;background:var(--accent);color:var(--accent-ink);display:flex;align-items:center;justify-content:center;font-size:16px;transform:translateY(12px) scale(.6);opacity:0;transition:all .4s var(--ease)}
.p-card:hover .go{transform:none;opacity:1}
.p-meta{display:flex;justify-content:space-between;gap:16px;padding:16px 2px 0;align-items:baseline}
.p-meta .yr{font-size:12px;color:var(--muted);letter-spacing:.1em}
.p-meta .cl{font-size:12px;color:var(--muted);text-transform:uppercase;letter-spacing:.12em}
.p-card h3{font-size:clamp(19px,2.1vw,26px);font-weight:600;margin-top:8px;line-height:1.2}
.p-card:hover h3{color:var(--accent)}
.p-card h3{transition:color .25s}
@media (max-width:820px){.work-grid{grid-template-columns:1fr}.work-grid .p-card:nth-child(even){transform:none}}
.work-more{display:flex;align-items:center;gap:20px;flex-wrap:wrap;justify-content:center;text-align:center;padding-top:clamp(56px,8vw,100px)}
.work-more .q{font-family:"Syne";font-size:clamp(24px,3vw,38px);font-weight:600}
.rate{display:inline-flex;align-items:center;gap:10px;border:1px solid var(--line);border-radius:14px;padding:12px 18px;font-size:13px;color:var(--muted);background:var(--bg2)}
.rate b{color:var(--ink)}
.rate .s{color:var(--accent)}

/* ---------- services list: big rows + hover thumb ---------- */
.services{background:var(--bg2);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.svc-intro{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,.8fr);gap:clamp(20px,4vw,60px);align-items:end;margin-bottom:clamp(40px,6vw,72px)}
.svc-intro h2{font-size:clamp(30px,4.4vw,58px);margin-top:14px}
.svc-intro p{color:var(--muted);max-width:44ch}
.svc-list{list-style:none;border-top:1px solid var(--line)}
.svc-row{border-bottom:1px solid var(--line);position:relative}
.svc-row a{display:flex;align-items:center;gap:clamp(14px,3vw,40px);padding:clamp(20px,3.2vw,34px) 4px;transition:padding .35s var(--ease)}
.svc-row .n{font-size:12px;color:var(--muted);font-variant-numeric:tabular-nums;letter-spacing:.1em;flex-shrink:0;width:34px}
.svc-row .t{font-family:"Syne";font-weight:500;font-size:clamp(28px,5.6vw,68px);letter-spacing:-.025em;line-height:1.05;color:#6F6A61;transition:color .3s}
.svc-row .d{margin-left:auto;display:flex;align-items:center;gap:16px}
.svc-row .desc{display:none;font-size:13px;color:var(--muted);max-width:34ch;text-align:right}
.svc-row .arr{width:46px;height:46px;flex-shrink:0;border:1px solid var(--line);border-radius:999px;display:flex;align-items:center;justify-content:center;color:var(--muted);transition:all .35s var(--ease)}
.svc-row:hover a{padding-left:clamp(10px,2vw,26px)}
.svc-row:hover .t{color:var(--ink)}
.svc-row.on .t{color:var(--accent)}
.svc-row.on .arr{background:var(--accent);color:var(--accent-ink);border-color:var(--accent);transform:rotate(-45deg)}
.svc-thumb{position:fixed;width:clamp(160px,18vw,260px);aspect-ratio:4/3;border-radius:12px;overflow:hidden;pointer-events:none;opacity:0;transform:translate(-50%,-50%) scale(.85) rotate(-4deg);transition:opacity .3s,transform .3s var(--ease);z-index:55;box-shadow:0 20px 60px rgba(0,0,0,.55)}
.svc-thumb.show{opacity:1;transform:translate(-50%,-50%) scale(1) rotate(-3deg)}
.svc-thumb img{width:100%;height:100%;object-fit:cover}
@media (max-width:700px){.svc-thumb{display:none}.svc-intro{grid-template-columns:1fr}}
.svc-foot{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-top:clamp(32px,5vw,56px);align-items:center}
.hear{display:inline-flex;align-items:center;gap:12px;background:var(--bg3);border:1px solid var(--line);border-radius:999px;padding:8px 20px 8px 8px;cursor:pointer;transition:border-color .25s}
.hear:hover{border-color:var(--accent)}
.hear .p{width:38px;height:38px;border-radius:999px;background:var(--accent);color:var(--accent-ink);display:flex;align-items:center;justify-content:center;font-size:13px}
.hear b{font-size:13px;display:block}.hear span{font-size:11px;color:var(--muted)}

/* ---------- testimonial ---------- */
.tstm{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:clamp(24px,4vw,56px);align-items:center;background:var(--bg2);border:1px solid var(--line);border-radius:clamp(20px,3vw,32px);padding:clamp(24px,4vw,56px)}
.tstm .media{position:relative;border-radius:var(--r);overflow:hidden;aspect-ratio:4/3.2}
.tstm .media img{width:100%;height:100%;object-fit:cover}
.tstm .play{position:absolute;inset:0;margin:auto;width:74px;height:74px;border-radius:999px;background:rgba(214,230,75,.94);color:var(--accent-ink);display:flex;align-items:center;justify-content:center;font-size:20px;border:0;cursor:pointer;transition:transform .3s var(--ease)}
.tstm .play:hover{transform:scale(1.08)}
.tstm blockquote{font-family:"Syne";font-weight:500;font-size:clamp(22px,3vw,40px);line-height:1.3;letter-spacing:-.015em}
.tstm blockquote .hl{color:var(--accent)}
.tstm .who{display:flex;align-items:center;gap:14px;margin-top:28px}
.tstm .who .av{width:46px;height:46px;border-radius:999px;background:var(--gold);color:#15140E;display:flex;align-items:center;justify-content:center;font-family:"Syne";font-weight:700}
.tstm .who b{font-size:14px;display:block}.tstm .who span{font-size:12px;color:var(--muted)}
@media (max-width:880px){.tstm{grid-template-columns:1fr}}

/* ---------- stats ---------- */
.stats{border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.stats-in{display:grid;grid-template-columns:repeat(4,1fr)}
.stat{padding:clamp(30px,4.5vw,56px) clamp(14px,2vw,28px);border-left:1px solid var(--line);transition:background .3s}
.stat:first-child{border-left:0}
.stat:hover{background:var(--bg2)}
.stat .num{font-family:"Syne";font-weight:700;font-size:clamp(38px,5vw,74px);letter-spacing:-.03em;color:var(--ink)}
.stat .num i{font-style:normal;color:var(--accent)}
.stat .lb{font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin-top:6px}
@media (max-width:760px){.stats-in{grid-template-columns:1fr 1fr}.stat:nth-child(3){border-left:0}.stat{border-top:1px solid var(--line)}.stat:nth-child(-n+2){border-top:0}}

/* ---------- CTA marquee ---------- */
.cta-mq{padding:clamp(70px,10vw,130px) 0;overflow:hidden;position:relative}
.mq-row{display:flex;width:max-content;align-items:center;gap:clamp(24px,4vw,60px);margin:10px 0}
.mq-row .w{font-family:"Syne";font-weight:700;font-size:clamp(46px,8.6vw,130px);letter-spacing:-.03em;line-height:1;white-space:nowrap}
.mq-row .w.outline{color:transparent;-webkit-text-stroke:1.5px rgba(244,241,234,.28)}
.mq-row .w a{transition:color .25s}
.mq-row .w a:hover{color:var(--accent)}
.mq-row .disc{width:clamp(56px,8vw,104px);aspect-ratio:1;border-radius:999px;background:var(--accent);color:var(--accent-ink);display:flex;align-items:center;justify-content:center;font-size:clamp(20px,3vw,36px);flex-shrink:0;transition:transform .4s var(--ease)}
.mq-row .disc:hover{transform:rotate(-45deg) scale(1.06)}
.mq-r1{animation:mqm 30s linear infinite}
.mq-r2{animation:mqm 30s linear infinite reverse}
.cta-mq:hover .mq-row{animation-play-state:paused}

/* ---------- insights ---------- */
.ins-track{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(min(84%,420px),1fr);gap:clamp(18px,2.4vw,28px);overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;padding-bottom:8px}
.ins-track::-webkit-scrollbar{display:none}
.ins-card{scroll-snap-align:start;border:1px solid var(--line);border-radius:var(--r);overflow:hidden;background:var(--bg2);transition:transform .4s var(--ease),border-color .3s;display:flex;flex-direction:column}
.ins-card:hover{transform:translateY(-6px);border-color:rgba(214,230,75,.35)}
.ins-card .im{aspect-ratio:16/10;overflow:hidden}
.ins-card .im img{width:100%;height:100%;object-fit:cover;transition:transform 1s var(--ease)}
.ins-card:hover .im img{transform:scale(1.05)}
.ins-card .bd{padding:20px 22px 22px;display:flex;flex-direction:column;flex:1}
.ins-card .k{display:flex;justify-content:space-between;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}
.ins-card h3{font-size:18px;font-weight:600;margin-top:10px;line-height:1.3}
.ins-card p{font-size:13px;color:var(--muted);margin-top:8px}
.ins-card .go2{margin-top:auto;padding-top:16px;display:flex;justify-content:space-between;align-items:center;font-size:13px;color:var(--accent);font-weight:600}
.ins-nav{display:flex;gap:10px}
.ins-nav button{width:46px;height:46px;border-radius:999px;border:1px solid var(--line);background:none;color:var(--ink);font-size:15px;cursor:pointer;transition:all .25s}
.ins-nav button:hover{background:var(--accent);color:var(--accent-ink);border-color:var(--accent)}

/* ---------- AI answers ---------- */
.ai{background:var(--bg2);border-top:1px solid var(--line)}
.ai-grid{display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr);gap:clamp(28px,5vw,72px);align-items:start}
.ai h2{font-size:clamp(28px,3.6vw,48px);margin-top:14px}
.ai .side p{color:var(--muted);margin-top:16px;max-width:36ch;font-size:14px}
.ai-tabs{display:flex;gap:10px;flex-wrap:wrap;margin:18px 0 22px}
.ai-tabs button{font:600 13px "Sora";padding:10px 18px;border-radius:999px;border:1px solid var(--line);background:rgba(255,255,255,.02);color:var(--muted);cursor:pointer;transition:all .25s;display:flex;align-items:center;gap:8px}
.ai-tabs button .pt{width:8px;height:8px;border-radius:99px;background:currentColor;opacity:.5}
.ai-tabs button.on{background:var(--accent);border-color:var(--accent);color:var(--accent-ink)}
.ai-tabs button.on .pt{opacity:1}
.ai-box{border:1px solid var(--line);border-radius:var(--r);background:var(--bg);padding:clamp(20px,3vw,34px);min-height:220px}
.ai-box .src{display:flex;align-items:center;gap:10px;font-size:12px;color:var(--muted);border-bottom:1px solid var(--line);padding-bottom:14px;margin-bottom:18px}
.ai-box .src .b{width:24px;height:24px;border-radius:8px;background:var(--bg3);display:flex;align-items:center;justify-content:center;font-size:11px;color:var(--accent)}
.ai-box .ans{font-size:15px;line-height:1.7;color:#D8D3C9;animation:fadeup .5s var(--ease)}
.ai-box .ans b{color:var(--ink)}
@keyframes fadeup{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
@media (max-width:900px){.ai-grid{grid-template-columns:1fr}}

/* ---------- footer ---------- */
.ftr{border-top:1px solid var(--line);padding-top:clamp(56px,8vw,96px);position:relative;overflow:hidden}
.ftr-cols{display:grid;grid-template-columns:1.4fr repeat(4,1fr);gap:clamp(24px,3vw,40px);padding-bottom:clamp(48px,7vw,88px)}
.ftr-cols h3{font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);font-weight:600;margin-bottom:16px}
