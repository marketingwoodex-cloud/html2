<script>
(function(){
  const bar=document.getElementById('ux-progress');
  window.addEventListener('scroll',()=>{ const h=document.documentElement; const scrolled=(h.scrollTop/(h.scrollHeight-h.clientHeight))*100; if(bar) bar.style.width=scrolled+'%'; }, {passive:true});
  const form=document.getElementById('ux-form-el');
  const submit=document.getElementById('ux-submit');
  const feedback=document.getElementById('ux-feedback');
  if(form){
    const inputs=form.querySelectorAll('input, textarea');
    inputs.forEach(inp=>{
      inp.addEventListener('blur',()=>{
        if(!inp.checkValidity()){
          inp.style.borderColor='#DC2626';
          inp.style.boxShadow='0 0 0 2px rgba(220,38,38,0.1)';
        } else {
          inp.style.borderColor='var(--border)';
          inp.style.boxShadow='none';
        }
      });
      inp.addEventListener('input',()=>{
        if(inp.checkValidity()){
          inp.style.borderColor='var(--border)';
          inp.style.boxShadow='none';
        }
      });
    });
    form.addEventListener('submit', (e)=>{
      if(!form.checkValidity()){
        e.preventDefault();
        inputs.forEach(inp=>{ if(!inp.checkValidity()){ inp.style.borderColor='#DC2626'; inp.style.boxShadow='0 0 0 2px rgba(220,38,38,0.1)'; } });
        if(feedback){ feedback.style.display='block'; feedback.style.background='#FEF2F2'; feedback.style.border='1px solid #FECACA'; feedback.style.color='#DC2626'; feedback.textContent='Please fill all required fields — Name, Phone, Email, Space brief.'; }
        return;
      }
      if(submit){
        submit.disabled=true;
        submit.style.opacity='0.7';
        const label=submit.querySelector('.label span:first-child');
        if(label) label.textContent='Sending...';
        if(feedback){ feedback.style.display='block'; feedback.style.background='#FFFBEB'; feedback.style.border='1px solid #FDE68A'; feedback.style.color='#A16207'; feedback.textContent='Sending your brief — please wait...'; }
      }
      if(window.trackEvent) trackEvent('contact_form_submit_premium');
    });
  }
  document.querySelectorAll('details').forEach(d=>{
    const sum=d.querySelector('summary'); if(!sum) return;
    const p=d.querySelector('p'); const ic=sum.querySelector('span:last-child');
    d.addEventListener('toggle',()=>{ if(d.open){ if(p) p.style.display='block'; if(ic) ic.textContent='−'; } else { if(p) p.style.display='none'; if(ic) ic.textContent='+'; } });
  });
  const anims=document.querySelectorAll('[data-anim]');
  if('IntersectionObserver' in window){
    const io=new IntersectionObserver(entries=>{ entries.forEach(e=>{ if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target);} }); }, {threshold:0.15});
    anims.forEach(el=>io.observe(el));
  } else { anims.forEach(el=>el.classList.add('in')); }
})();
</script>

